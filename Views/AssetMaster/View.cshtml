@using SparkHRMS.Data.Masters


@model SparkHRMS.Data.Masters.AssetMaster

@{
    ViewData["Title"] = "Edit Asset";
}

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title"> Assets</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            <i class="fas fa-add"></i> Edit
        </a>
    </li>
</ul>
<hr />
<div class="card p-3">
    <form asp-action="Edit">
        <input type="hidden" asp-for="AssetId" />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Asset Name</label>
                    <input asp-for="AssetName" class="form-control" disabled/>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Asset Code</label>
                    <input asp-for="AssetCode" class="form-control" disabled />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Vendor</label>
                    <input asp-for="Vendor" class="form-control" disabled />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Purchase Date</label>
                    <input asp-for="PurchaseDate" type="date" class="form-control" disabled />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Warranty Months</label>
                    <input asp-for="WarrantyMonths" type="number" class="form-control" disabled />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-control"></select>
                </div>
            </div>
        </div>

        <div class="col-lg-12 p-t-20 text-center">
            <div class="form-group">
                <a type="button" class="btn btn-danger waves-effect" href="@Url.Action("Index")">Cancel</a>
            </div>
        </div>

    </form>

</div>