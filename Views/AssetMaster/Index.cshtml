

@model IEnumerable<SparkHRMS.Data.Masters.AssetMaster>
@{
    ViewData["Title"] = "Assets List";
}

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Asset Master</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Create")" style="float:right;">
            <i class="material-icons">add</i>
        </a>
    </div>
</div>

<table class="table table-bordered mt-3" id="assetTable">
    <thead>
        <tr>
            @* <th></th> *@
            <th>Name</th>
            <th>Code</th>
            <th>Vendor</th>
            <th>Warrent In Months</th>
            <th>Purchase Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var asset in Model)
        {
            <tr>
                @* <td>@asset.AssetId</td> *@
                <td>@asset.AssetName</td>
                <td>@asset.AssetCode</td>
                <td>@asset.Vendor</td>
                <td>@asset.WarrantyMonths</td>
                <td>@asset.PurchaseDate.ToShortDateString()</td>
                <td>@asset.Status</td>
                <td>
                    <a class="btn btn-warning btn-sm" href="@Url.Action("Edit", new { id = asset.AssetId })">Edit</a>
                    <a class="btn btn-info btn-sm" href="@Url.Action("View", new { id = asset.AssetId })">View</a>
                    @* <a class="btn btn-danger btn-sm" href="@Url.Action("Delete", new { id = asset.AssetId })">Delete</a> *@
                </td> 
            </tr>
        }
    </tbody>
</table>
<script src="~/js/assetmaster.js"></script>
