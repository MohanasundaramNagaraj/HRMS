@inject SparkHRMS.Utilities.Utility UtilityService

@model IEnumerable<SparkHRMS.Data.Setting.AssetMaintenance>

@{
    ViewData["Title"] = "Asset Maintenance Records";
}

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Asset Maintenance Records</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Create")" style="float:right;">
            <i class="material-icons">add</i>
        </a>
    </div>
</div>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Asset Code</th>
            <th>Asset Name</th>
            <th>Maintenance Date</th>
            <th>Issue Description</th>
            <th>Provider</th>
            <th>Cost</th>
            <th>Resolved</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var maintenance in Model)
        {
            var asset = UtilityService.GetAssetById(maintenance.AssetId);
            <tr>
                <td>@asset.AssetCode</td>
                <td>@asset.AssetName</td>
                <td>@maintenance.MaintenanceDate.ToShortDateString()</td>
                <td>@maintenance.IssueDescription</td>
                <td>@maintenance.MaintenanceProvider</td>
                <td>@(maintenance.MaintenanceCost.HasValue ? $"{maintenance.MaintenanceCost.Value}" : "-")</td>
                <td>@(maintenance.IsResolved ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-warning btn-sm" href="@Url.Action("Edit", new { id = maintenance.MaintenanceId })">Edit</a>
                    <a class="btn btn-danger btn-sm" href="@Url.Action("Delete", new { id = maintenance.MaintenanceId })">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
