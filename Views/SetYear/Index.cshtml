@model IEnumerable<SparkHRMS.Data.Setting.SetYear>
@{
    ViewData["Title"] = "Set Years";
}
<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Year</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Create")"
           style="float:right;">
            <i class="material-icons">add</i>
        </a>
    </div>
</div>
<hr />

<div class="mt-4">
   
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Year</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Is Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Year</td>
                    <td>@item.StartDate.ToShortDateString()</td>
                    <td>@item.EndDate.ToShortDateString()</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    @*     <a class="btn btn-sm btn-danger delete-confirm" asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.delete-confirm').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const url = this.getAttribute('href');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = url;
                    }
                });
            });
        });
    </script>
}
