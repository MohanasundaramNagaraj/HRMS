<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dynamic Modal Rendering</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f7fa;
            margin: 0;
        }

        .header {
            background: #cfe0f4;
            padding: 20px;
            font-size: 20px;
            text-align: center;
        }

        .section-container {
            display: flex;
            justify-content: space-around;
            margin-top: 30px;
        }

        .section {
            width: 45%;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background: #a3b8cc;
            padding: 10px;
            text-align: center;
        }

        td {
            background: #d9d5bf;
            padding: 10px;
            text-align: center;
        }

        .btn {
            background: #3b78c2;
            color: #fff;
            border: none;
            padding: 8px 14px;
            cursor: pointer;
            border-radius: 5px;
            margin-top: 8px;
        }

            .btn:hover {
                background: #2c5e99;
            }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
        }

        .modal-content {
            background: white;
            width: 350px;
            margin: 10% auto;
            padding: 20px;
            border-radius: 10px;
        }

        .close {
            float: right;
            font-size: 22px;
            cursor: pointer;
        }

        .form-row {
            margin: 10px 0;
            display: flex;
            flex-direction: column;
            text-align: left;
        }

        input {
            padding: 6px;
            border: 1px solid #bbb;
            border-radius: 5px;
        }

    </style>
    <script>
            let currentMode = ""; // plan or actuals

        function openModal(mode) {
            currentMode = mode;

            document.getElementById("modal").style.display = "block";

            document.getElementById("modalTitle").innerText =
                mode === "plan" ? "Add Plan" : "Add Actuals";

            document.getElementById("hoursLabel").innerText =
                mode === "plan" ? "Planned Hours" : "Actual Hours";
        }

        function closeModal() {
            document.getElementById("modal").style.display = "none";
        }

        function saveData() {
            let taskId = document.getElementById("taskId").value;
            let activity = document.getElementById("activity").value;
            let description = document.getElementById("description").value;
            let hours = document.getElementById("hours").value;

            if (!taskId || !activity || !description || !hours) {
                alert("Please fill all fields");
                return;
            }

            let table = currentMode === "plan"
                ? document.getElementById("planTable").querySelector("tbody")
                : document.getElementById("actualTable").querySelector("tbody");

            let row = table.insertRow();

            row.innerHTML = `
                <td>${taskId}</td>
                <td>${activity}</td>
                <td>${description}</td>
                <td>${hours}</td>
                <td><button class="btn" onclick="deleteRow(this)">Delete</button></td>
            `;

            closeModal();

            // clear inputs
            document.getElementById("taskId").value = "";
            document.getElementById("activity").value = "";
            document.getElementById("description").value = "";
            document.getElementById("hours").value = "";
        }

        function deleteRow(btn) {
            btn.parentElement.parentElement.remove();
        }

    </script>
</head>
<body>

    <div class="header">01-12-2025 - Monday</div>

    <div class="section-container">
        <div class="section">
            <h2>Plan</h2>

            <button class="btn" onclick="openModal('plan')">Add Plan</button>

            <table id="planTable">
                <thead>
                    <tr>
                        <th>Task Id</th>
                        <th>Activity</th>
                        <th>Description</th>
                        <th>Planned Hours</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="section">
            <h2>Actuals</h2>

            <button class="btn" onclick="openModal('actuals')">Add Actuals</button>

            <table id="actualTable">
                <thead>
                    <tr>
                        <th>Task Id</th>
                        <th>Activity</th>
                        <th>Description</th>
                        <th>Actual Hours</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- MODAL -->
    <div id="modal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>

            <h2 id="modalTitle"></h2>

            <div class="form-row">
                <label>Task Id</label>
                <input id="taskId" type="text">
            </div>

            <div class="form-row">
                <label>Activity</label>
                <input id="activity" type="text">
            </div>

            <div class="form-row">
                <label>Description</label>
                <input id="description" type="text">
            </div>

            <div class="form-row">
                <label id="hoursLabel"></label>
                <input id="hours" type="number">
            </div>

            <button class="btn" onclick="saveData()">Save</button>
        </div>
    </div>

    <script src="script.js"></script>

</body>
</html>
