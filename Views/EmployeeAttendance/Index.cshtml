@using Microsoft.AspNetCore.Identity
@using SparkHRMS.Data.Entities
@using SparkHRMS.Utilities
@using SparkHRMS.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Employee Attendance";
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();


}

<link href="~/app/assets/css/bundles/dataTables.bootstrap5.min.css" rel="stylesheet">

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title">Attendance</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            List
        </a>
    </li>
</ul>

<div class="row clearfix">
    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
    {
        <div class="col-md-12 mb-3">
            <div>
                <div class="">
                    <select id="monthSelector" style="width:35%;margin-right:10px;display:inline-block">
                        <option value="">Select Month</option>
                        @for (int month = 1; month <= 12; month++)
                        {
                            if (month == ViewBag.SelectedMonth)
                            {
                                <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                            else
                            {
                                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                        }
                    </select>
                    <select style="width:35%;margin-right:10px;display:inline-block" id="empSelector">
                        @{
                            var employeeList = ViewBag.EmployeeList;
                        }

                        @foreach (var record in employeeList)
                        {
                            if (ViewBag.SelectedEmployeeID == record.EmployeeId)
                            {
                                <option value="@record.EmployeeId" selected>@record.EmployeeCode - @record.Name</option>
                            }
                            else
                            {
                                <option value="@record.EmployeeId">@record.EmployeeCode - @record.Name</option>
                            }
                        }
                    </select>
                    <button onclick="getData()" class="btn btn-info">
                        Filter
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12 col-md-12">
        @*  <div class="card">
        <div class="profile-tab-box">
        <div class="p-l-20">
        <ul class="nav ">
        <li class="nav-item tab-all">
        <a class="nav-link active show" href="#project"
        data-bs-toggle="tab">Attendance</a>
        </li>
        <li class="nav-item tab-all p-l-20">
        <a class="nav-link" href="#usersettings" data-bs-toggle="tab">Report</a>
        </li>
        </ul>
        </div>
        </div>
        </div> *@
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="project" aria-expanded="true">
                <div class="row clearfix">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        <div class="card">
                            <div class="chat">
                                <div class="chat-header clearfix">
                                    @{
                                        var UserImageUrl = "";
                                        int lastSlashIndex = @Model.EmployeeDetails.ImageUrl.LastIndexOf('/');
                                        if (lastSlashIndex >= 0)
                                        {
                                             UserImageUrl = Url.Content("~/uploads/" + Model.EmployeeDetails.ImageUrl.Substring(lastSlashIndex + 1));
                                        }           
                                    }
                                    <img src="@UserImageUrl" alt="avatar">
                                    <div class="row">
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">@Model.EmployeeDetails.Name</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.Designation</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">Employee ID</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.EmpCode</div>
                                                <div style="display:none;">@Model.EmployeeDetails.EmployeeId</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">Joining Date</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.DateOfJoining?.ToString("dd MMM yyyy")</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">Email</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.Email</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card project_widget">
                            <div class="header">
                            </div>
                            <div class="body">
                                <div class="row">
                                    <div class="col-lg-3 col-sm-3">
                                        <div class="text-center m-b-20">
                                            <h3 class="m-b-10 col-green">@Model.MonthlySummary.TotalWorkingHoursThisMonth</h3>
                                            <div class="text font-15 m-b-5">Total Working Hours</div>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end mb-3 col-lg-9 col-sm-9">
                                    </div>
                                </div>

                                @*<div class="row">
                                <div class="col-lg-3 col-sm-6">
                                <div class="text-center m-b-20">
                                <h3 class="m-b-10 col-green">08:00</h3>
                                <div class="text font-15 m-b-5">Average Working Hours</div>
                                </div>
                                </div>*@
                                <div class="table-responsive">
                                    <table class="table table-hover js-basic-example contact_list">
                                        <thead>
                                            <tr>
                                                <th class="center"> Date </th>
                                                <th class="center"> Check In </th>
                                                <th class="center"> Check Out </th>
                                                <th class="center"> Working Hours </th>
                                                 @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
                                                {
                                                    <th class="center"> Check In IP </th>
                                                    <th class="center"> Check Out IP </th>
                                                }
                                                <th class="center"> Status </th>
                                                @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
                                                {
                                                    <th class="center"> Action </th>
                                                }

                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var record in Model.MonthlySummary.DailyAttendanceRecords)
                                            {
                                                <tr class="odd gradeX">
                                                    <td class="center">@record.Date.ToString("dd MMM yyyy")</td>
                                                    <td class="center" style="width: 200px !important;
                                                                      max-width: 300px !important;
                                                                      min-width: 200px !important;
                                                                      word-wrap: anywhere;">
                                                        @if (record.CheckInTimeInString == "Not Checked In" && (record.Status == AttendanceStatus.Absent || record.Status == AttendanceStatus.Holiday || record.Status == AttendanceStatus.Weekend))
                                                        {
                                                            <span>-</span>
                                                        }
                                                        else
                                                        {
                                                            @record.CheckInTimeInString
                                                        }
                                                        <br />
                                                        @record.CheckInLocation
                                                    </td>
                                                    <td class="center" style="width: 200px !important;
                                                                      max-width: 300px !important;
                                                                      min-width: 200px !important;
                                                                      word-wrap: anywhere;">
                                                        @if (record.CheckOutTimeInString == "Not Checked Out" && record.Status == AttendanceStatus.Absent || record.Status == AttendanceStatus.Holiday || record.Status == AttendanceStatus.Weekend)
                                                        {
                                                            <span>-</span>
                                                        }
                                                        else
                                                        {
                                                            @record.CheckOutTimeInString
                                                        }
                                                       
                                                        <br />
                                                        @record.CheckOutLocation
                                                    </td>
                                                    <td class="center">@record.WorkingHours</td>
                                                    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
                                                    {
                                                        <td class="center">@record.IP</td>
                                                        <td class="center">@record.CheckOutMadeSystemIP</td>
                                                    }
                                                    <td class="center">

                                                        @{
                                                            if (record.Status == AttendanceStatus.Present)
                                                            {
                                                                <div class="badge col-green">Present</div>
                                                            }
                                                            else if (record.Status == AttendanceStatus.Absent)
                                                            {
                                                                <div class="badge col-red">Absent</div>
                                                            }
                                                            else if (record.Status == AttendanceStatus.Holiday)
                                                            {
                                                                <div class="badge col-cyan">Holiday</div>
                                                            }
                                                            else if (record.Status == AttendanceStatus.PermissionNeeded)
                                                            {
                                                                <div class="badge col-green">Taken Permission</div>
                                                            }
                                                            else if (record.Status == AttendanceStatus.Weekend)
                                                            {
                                                                <div class="badge col-cyan">Holiday</div>
                                                            }
                                                        }
                                                    </td>
                                                    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
                                                    {
                                                        <td>
                                                            <a href="@Url.Action("Add","AdminAttendanceViewer", new { EmployeeId = @Model.EmployeeDetails.EmployeeId,
                                                                date = @record.Date
                                                            })" class="btn btn-warning btn-sm p-t-10">
                                                                <i class="material-icons">create</i>
                                                            </a>
                                                        </td>
                                                    }
                                                </tr>
                                            }

                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" class="tab-pane" id="timeline" aria-expanded="false">
            </div>
            <div role="tabpanel" class="tab-pane" id="usersettings" aria-expanded="false">
                <div class="card">
                    <div class="header">
                        <h2>
                            <strong>Attendance</strong> Report
                        </h2>
                    </div>
                    <div class="body">
                        <div class="row clearfix">
                            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                <div class="card">
                                    <div class="body">
                                        <div id="pieChart"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <!-- Include SweetAlert from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @*  <script src="~/app/assets/js/common.min.js"></script> *@
    <script src="~/app/assets/js/table.min.js"></script>

    <script src="~/app/assets/js/pages/tables/jquery-datatable.js"></script>
    <script src="~/app/assets/js/bundles/amcharts5/index.js"></script>
    <script src="~/app/assets/js/bundles/amcharts5/percent.js"></script>
    <script src="~/app/assets/js/bundles/amcharts5/Animated.js"></script>
    <script src="~/app/assets/js/pages/attendance/attendance-data.js"></script>

    <script>
        function getData(obj) {
            debugger;

            var frm = $("<form hidden action='/EmployeeAttendance/Index' method='get'> </form>");
            $(frm).append("<input type=hidden name=EmployeeID value=" + parseInt($("#empSelector").val()) + " id=EmployeeID>");
            $(frm).append("<input type='hidden' name='Month' value=" + parseInt($("#monthSelector").val()) + " id='Month'>");
            $(document).find("body").append(frm);
            setTimeout(function () {
                $(frm).submit();
            }, 100);

        }
    </script>
}