@model IEnumerable<SparkHRMS.Data.Entities.Employee>

@{
    ViewData["Title"] = "Index";
}

<script src="~/js/Maintanance.js"></script>

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">All Employees</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <div class="d-flex justify-content-end mb-2">
            <button type="button" id="addButton" class="btn btn-success me-2">
                Add
            </button>

            <button type="button" id="editButton" class="btn btn-primary me-2">
                Edit
            </button>

            <button type="button" id="viewButton" class="btn btn-secondary me-2">
                View
            </button>
            <button type="button" id="deleteButton" class="btn btn-danger">
                Delete
            </button>

        </div>

    </div>
</div>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="card">
            <div class="body">
                <div class="table-responsive">
                    <table id="employeeListTable" style="width:100%"
                           class="table table-hover table-checkable order-column contact_list">
                        <thead>
                            <tr>
                                <th class="center">
                                    <input type="checkbox" id="selectAll" />
                                </th>
                                <th class="center">#</th>
                                <th class="center"></th>
                                <th class="center"> Code </th>
                                <th class="center"> Name </th>
                                <th class="center"> Designation </th>
                                <th class="center"> Mobile </th>
                                <th class="center"> Email </th>
                                <th class="center"> Joining Date </th>
                               
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 0;
                            }
                            @foreach (var item in Model)
                            {
                                index++;
                                <tr class="odd gradeX">
                                    <td class="center">
                                        <input type="checkbox" class="row-checkbox" data-id="@item.EmployeeId" />
                                    </td>
                                    <td>@index</td>
                                    <td class="table-img center">
                                        <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : Url.Content("~/app/assets/images/user/no-image.png"))"
                                             alt=""
                                             style="width: 45px;"
                                             onerror="this.onerror=null; this.src='@Url.Content("~/app/assets/images/user/no-image.png")';" />
                                    </td>
                                    <td class="center"> @Html.DisplayFor(modelItem => item.EmployeeCode)</td>
                                    <td class="center"> @Html.DisplayFor(modelItem => item.Name)</td>
                                    <td class="center"> @Html.DisplayFor(modelItem => item.Designation)</td>
                                    <td class="center"> @Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                                    <td class="center"> @Html.DisplayFor(modelItem => item.Email)</td>
                                    <td class="center"> @Html.DisplayFor(modelItem => item.DateOfJoining)</td>
                                   
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

