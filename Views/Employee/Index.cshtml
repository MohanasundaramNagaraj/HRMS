        .excel-history-download:hover {
            background: #e53935;
            transform: scale(1.1);
        }
    </style>
    <script>
        $(document).ready(function () {
            var table = $('#employeeListTable').DataTable({
                pageLength: 10,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                order: [],
                columnDefs: [
                    { orderable: false, targets: [0, 1] },
                    { searchable: false, targets: [0, 1] }
                ]
            });

            // Update employee count
            function updateEmployeeCount() {
                var count = table.rows().count();
                $('#empCount').text(count);
            }

            updateEmployeeCount();

            // Search functionality
            $('#empSearch').on('keyup', function() {
                table.search(this.value).draw();
            });

            // Entries per page
            $('#empEntriesPerPage').on('change', function() {
                var val = parseInt(this.value);
                table.page.len(val).draw();
            });
        });
    </script>

    <!-- ===================== Bulk Excel Import ===================== -->
    <script>
        $(function () {
            var pollTimer = null;
            var currentImportId = null;
            var anySucceeded = false; // reload the list on close when rows were added

            function openModal() {
                resetUi();
                loadHistory();
                $('#excelImportOverlay').addClass('open');
            }

            function closeModal() {
                stopPolling();
                $('#excelImportOverlay').removeClass('open');
                // Clear the session history when modal closes.
                $.post('@Url.Action("ClearImportHistory", "Employee")');
            }

            function closeAndReload() {
                stopPolling();
                $('#excelImportOverlay').removeClass('open');
                // Clear history and reload the page to show newly imported employees.
                $.post('@Url.Action("ClearImportHistory", "Employee")');
                setTimeout(function () {
                    location.reload();
                }, 600);
            }

            function resetUi() {
                $('#excelImportFile').val('');
                $('#excelImportProgressWrap').hide();
                $('#excelImportResult').hide().removeClass('alert-success alert-warning alert-danger');
                $('#excelImportErrorWrap').hide();
                $('#excelImportValidationError').hide().text('');
                setBar(0);
                $('#cntProcessed,#cntTotal,#cntSucceeded,#cntDuplicates,#cntFailed').text('0');
                $('#excelImportUpload').prop('disabled', false);
            }

            function showValidationError(message) {
                $('#excelImportValidationError').text(message).show();
            }

            function hideValidationError() {
                $('#excelImportValidationError').hide().text('');
            }

            function setBar(pct) {
                pct = Math.max(0, Math.min(100, pct || 0));
                $('#excelImportBar').css('width', pct + '%');
                $('#excelImportPercentText').text(pct + '%');
            }

            function stopPolling() {
                if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            }

            function startUpload() {
                hideValidationError();
                var fileInput = document.getElementById('excelImportFile');
                if (!fileInput.files || fileInput.files.length === 0) {
                    showValidationError('⚠️ Please choose an .xlsx file first.');
                    return;
                }

                anySucceeded = false;
                $('#excelImportResult').hide();
                $('#excelImportErrorWrap').hide();
                $('#excelImportProgressWrap').show();
                $('#excelImportUpload').prop('disabled', true);
                $('#excelImportPhase').text('Uploading file...');
                setBar(0);

                var formData = new FormData();
                formData.append('file', fileInput.files[0]);

                var xhr = new XMLHttpRequest();
                xhr.open('POST', '@Url.Action("BulkUploadStart", "Employee")', true);

                // File transfer is the first slice of the bar (caps at 10%); the
                // remaining 90% is driven by server-side row processing.
                xhr.upload.onprogress = function (e) {
                    if (e.lengthComputable) {
                        setBar(Math.round((e.loaded / e.total) * 10));
                    }
                };

                xhr.onload = function () {
                    var res;
                    try { res = JSON.parse(xhr.responseText); } catch (_) { res = null; }

                    if (!res || !res.success) {
                        $('#excelImportProgressWrap').hide();
                        $('#excelImportUpload').prop('disabled', false);
                        var msg = (res && res.message) ? res.message : 'Could not process the file.';
                        showValidationError('❌ ' + msg);
                        return;
                    }

                    currentImportId = res.importId;
                    $('#cntTotal').text(res.total);
                    $('#excelImportPhase').text('Importing employees...');
                    pollProgress();
                    pollTimer = setInterval(pollProgress, 800);
                };

                xhr.onerror = function () {
                    $('#excelImportProgressWrap').hide();
                    $('#excelImportUpload').prop('disabled', false);
                    showValidationError('❌ Network error: The upload could not be completed.');
                };

                xhr.send(formData);
            }

            function pollProgress() {
                if (!currentImportId) return;
                $.getJSON('@Url.Action("BulkUploadProgress", "Employee")', { importId: currentImportId })
                    .done(function (p) {
                        if (!p || !p.success) return;

                        setBar(p.Percent);
                        $('#cntProcessed').text(p.Processed);
                        $('#cntTotal').text(p.Total);
                        $('#cntSucceeded').text(p.Succeeded);
                        $('#cntDuplicates').text(p.Duplicates);
                        $('#cntFailed').text(p.Failed);

                        if (p.Done) {
                            stopPolling();
                            setBar(100);
                            $('#excelImportPhase').text('Completed');
                            $('#excelImportUpload').prop('disabled', false);
                            anySucceeded = p.Succeeded > 0;

                            var cls = p.Failed === 0 ? 'alert-success' : (p.Succeeded > 0 ? 'alert-warning' : 'alert-danger');
                            $('#excelImportResult')
                                .removeClass('alert-success alert-warning alert-danger')
                                .addClass(cls)
                                .text(p.Message)
                                .show();

                            if (p.HasErrorFile) {
                                $('#excelImportErrorDownload').attr(
                                    'href',
                                    '@Url.Action("DownloadErrorFile", "Employee")?importId=' + encodeURIComponent(currentImportId));
                                $('#excelImportErrorWrap').show();
                            }

                            loadHistory();

                            // Auto-close and reload after successful import (any rows imported).
                            if (p.Succeeded > 0) {
                                setTimeout(function () {
                                    closeAndReload();
                                }, 2500);
                            }
                        }
                    });
            }

            function loadHistory() {
                $.getJSON('@Url.Action("ImportHistory", "Employee")')
                    .done(function (res) {
                        var body = $('#excelImportHistoryBody');
                        body.empty();
                        if (!res || !res.success || !res.history || res.history.length === 0) {
                            body.append('<tr><td colspan="8" class="text-center text-muted py-3">No imports yet.</td></tr>');
                            return;
                        }
                        res.history.forEach(function (h) {
                            var fileName = h.FileName || h['FileName'] || '';
                            var importedOn = h.ImportedOn || h['ImportedOn'] || '';
                            var importedBy = h.ImportedBy || h['ImportedBy'] || 'System';
                            var total = h.Total || h['Total'] || 0;
                            var succeeded = h.Succeeded || h['Succeeded'] || 0;
                            var duplicates = h.Duplicates || h['Duplicates'] || 0;
                            var failed = h.Failed || h['Failed'] || 0;
                            var hasError = h.HasErrorFile || h['HasErrorFile'] || false;

                            var dl = hasError
                                ? '<a href="@Url.Action("DownloadErrorFile", "Employee")?importId=' + encodeURIComponent(h.ImportId) + '" class="excel-history-download" title="Download error file"><i class="fas fa-download"></i></a>'
                                : '';
                            var row = '<tr>' +
                                '<td class="excel-hist-file">' + escapeHtml(fileName) + '</td>' +
                                '<td class="excel-hist-date">' + escapeHtml(importedOn) + '</td>' +
                                '<td class="excel-hist-by">' + escapeHtml(importedBy) + '</td>' +
                                '<td class="text-end">' + total + '</td>' +
                                '<td class="text-end excel-hist-success">' + succeeded + '</td>' +
                                '<td class="text-end excel-hist-warn">' + duplicates + '</td>' +
                                '<td class="text-end excel-hist-error">' + failed + '</td>' +
                                '<td class="text-center">' + dl + '</td>' +
                                '</tr>';
                            body.append(row);
                        });
                    });
            }

            function escapeHtml(s) {
                return (s == null ? '' : '' + s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }

            $('#importExcelButton').on('click', openModal);
            $('#excelImportClose').on('click', closeModal);
            $('#excelImportUpload').on('click', startUpload);
            $('#excelImportHistoryRefresh').on('click', loadHistory);

            // Click on the dark backdrop (not the dialog) closes the modal.
            $('#excelImportOverlay').on('click', function (e) {
                if (e.target === this) closeModal();
            });
        });
    </script>
}
