@model IEnumerable<SparkHRMS.Data.Entities.Employee>

@{
    ViewData["Title"] = "Index";
}

<script src="~/js/Maintanance.js" asp-append-version="true"></script>

<!-- Page Header -->
<div class="emp-page-header mb-4">
    <div class="emp-header-left">
        <h2 class="emp-page-title">
            <i class="fas fa-users me-2"></i>Employee Management
        </h2>
        <p class="emp-page-subtitle">Manage and organize all employee records</p>
    </div>

    <div class="emp-header-right">
        <div id="employeeCountBadge" class="emp-count-badge">
            <i class="fas fa-users-cog"></i>
            <span id="empCount">0</span> Employees
        </div>
    </div>
</div>

<!-- Controls Bar -->
<div class="emp-controls-bar mb-3">
    <div class="emp-controls-left">
        <div class="emp-search-wrapper">
           @*  <i class="fas fa-search"></i> *@
            <input type="text" id="empSearch" class="emp-search-input" placeholder="Search by name, email, or code..." />
        </div>

        <select id="empEntriesPerPage" class="emp-entries-select">
            <option value="10">10 per page</option>
            <option value="25">25 per page</option>
            <option value="50">50 per page</option>
            <option value="100">100 per page</option>
        </select>
    </div>

    <div class="emp-controls-right">
        <button type="button" id="importExcelButton" class="emp-btn emp-btn-excel" title="Bulk import employees from Excel">
            <i class="fas fa-file-excel me-2"></i>Import Excel
        </button>

        <button type="button" id="addButton" class="emp-btn emp-btn-primary" title="Add new employee">
            <i class="fas fa-plus me-2"></i>Add
        </button>

        <div class="emp-btn-group">
            <button type="button" id="editButton" class="emp-btn emp-btn-secondary" title="Edit selected employee">
                <i class="fas fa-edit me-2"></i>Edit
            </button>

            <button type="button" id="viewButton" class="emp-btn emp-btn-info" title="View selected employee">
                <i class="fas fa-eye me-2"></i>View
            </button>

            <button type="button" id="deleteButton" class="emp-btn emp-btn-danger" title="Delete selected employee">
                <i class="fas fa-trash me-2"></i>Delete
            </button>
        </div>
    </div>
</div>

<!-- Employee Table Card -->
<div class="emp-table-card">
    <div class="emp-table-wrapper">
        <table id="employeeListTable" class="emp-table">
            <thead>
                <tr>
                    <th class="emp-col-num">#</th>
                    <th class="emp-col-photo"></th>
                    <th class="emp-col-code">Code</th>
                    <th class="emp-col-name">Name</th>
                    <th class="emp-col-designation">Designation</th>
                    <th class="emp-col-mobile">Mobile</th>
                    <th class="emp-col-email">Email</th>
                    <th class="emp-col-date">Joining Date</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 0;
                }
                @foreach (var item in Model)
                {
                    index++;
                    <tr class="emp-row employee-row" data-id="@item.EmployeeId" title="Double-click to select">
                        <td class="emp-col-num">@index</td>
                        <td class="emp-col-photo">
                            <img src="@(!string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : Url.Content("~/app/assets/images/user/no-image.png"))"
                                 alt="@item.Name"
                                 class="emp-photo"
                                 onerror="this.onerror=null; this.src='@Url.Content("~/app/assets/images/user/no-image.png")';" />
                        </td>
                        <td class="emp-col-code">
                            <span class="emp-code-badge">@Html.DisplayFor(modelItem => item.EmployeeCode)</span>
                        </td>
                        <td class="emp-col-name">
                            <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                        </td>
                        <td class="emp-col-designation">
                            <span class="emp-designation-badge">@Html.DisplayFor(modelItem => item.Designation)</span>
                        </td>
                        <td class="emp-col-mobile">@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                        <td class="emp-col-email">
                            <a href="mailto:@item.Email" class="emp-email-link">@Html.DisplayFor(modelItem => item.Email)</a>
                        </td>
                        <td class="emp-col-date">@(item.DateOfJoining.HasValue ? item.DateOfJoining.Value.ToString("dd/MM/yyyy") : "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ============== Bulk Excel Import Modal (Professional Design) ============== -->
<div id="excelImportOverlay" class="excel-import-overlay">
    <div class="excel-import-dialog">
        <!-- Header -->
        <div class="excel-import-header">
            <div class="d-flex align-items-center">
                <div class="excel-import-icon">
                    <i class="fas fa-file-excel"></i>
                </div>
                <div>
                    <h4 class="mb-0">Bulk Employee Import</h4>
                    <p class="mb-0 text-muted small">Upload multiple employees at once</p>
                </div>
            </div>
            <button type="button" class="excel-import-close" id="excelImportClose">&times;</button>
        </div>

        <div class="excel-import-body">

            <!-- Validation error -->
            <div id="excelImportValidationError" style="display:none;" class="excel-alert excel-alert-danger mb-4"></div>

            <!-- Steps Container -->
            <div class="excel-steps-container">
                <!-- Step 1 -->
                <div class="excel-step-card">
                    <div class="excel-step-badge">1</div>
                    <div class="excel-step-content">
                        <h6 class="mb-1">Download Template</h6>
                        <p class="mb-3 text-muted small">Download the Excel template and fill employee details. Required columns are highlighted.</p>
                        <a href="@Url.Action("DownloadTemplate", "Employee")" class="btn btn-sm excel-btn-primary">
                            <i class="fas fa-download me-1"></i>Download Template
                        </a>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="excel-step-card">
                    <div class="excel-step-badge">2</div>
                    <div class="excel-step-content">
                        <h6 class="mb-1">Upload File</h6>
                        <p class="mb-3 text-muted small">Select the filled .xlsx file and click Upload & Import to start the process.</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <input type="file" id="excelImportFile" accept=".xlsx" class="excel-file-input" />
                            <button type="button" id="excelImportUpload" class="btn btn-sm excel-btn-success">
                                <i class="fas fa-upload me-1"></i>Upload & Import
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Progress Section -->
            <div id="excelImportProgressWrap" style="display:none;" class="excel-progress-section mt-4 pt-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span id="excelImportPhase" class="fw-semibold">Processing...</span>
                    <span id="excelImportPercentText" class="badge excel-badge-primary">0%</span>
                </div>
                <div class="excel-progress-bar-wrapper">
                    <div id="excelImportBar" class="excel-progress-bar"></div>
                </div>
                <div class="excel-progress-stats mt-3">
                    <div class="stat-item">
                        <span class="stat-label">Processed:</span>
                        <span class="stat-value"><b id="cntProcessed">0</b>/<b id="cntTotal">0</b></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label text-success">✓ Imported:</span>
                        <span class="stat-value text-success"><b id="cntSucceeded">0</b></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label text-warning">⚠ Duplicates:</span>
                        <span class="stat-value text-warning"><b id="cntDuplicates">0</b></span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label text-danger">✕ Errors:</span>
                        <span class="stat-value text-danger"><b id="cntFailed">0</b></span>
                    </div>
                </div>
            </div>

            <!-- Result Section -->
            <div id="excelImportResult" style="display:none;" class="excel-alert mt-4 mb-3"></div>
            <div id="excelImportErrorWrap" style="display:none;" class="excel-error-section mt-4 p-3">
                <div class="d-flex align-items-center gap-3">
                    <i class="fas fa-exclamation-circle text-danger"></i>
                    <div class="flex-grow-1">
                        <strong>Some rows had errors</strong>
                        <p class="mb-0 text-muted small">Download the error file, fix the issues, and re-upload.</p>
                    </div>
                    <a href="#" id="excelImportErrorDownload" class="btn btn-sm excel-btn-danger">
                        <i class="fas fa-download me-1"></i>Error File
                    </a>
                </div>
            </div>

            <!-- History Section -->
            <div class="excel-history-section mt-4 pt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0"><i class="fas fa-history me-2"></i>Import History</h6>
                    <button type="button" id="excelImportHistoryRefresh" class="btn btn-sm excel-btn-ghost">Refresh</button>
                </div>
                <div class="excel-history-table-wrapper">
                    <table class="excel-history-table">
                        <thead>
                            <tr>
                                <th>File</th>
                                <th>Date</th>
                                <th>By</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Imported</th>
                                <th class="text-end">Dupes</th>
                                <th class="text-end">Errors</th>
                                <th width="40"></th>
                            </tr>
                        </thead>
                        <tbody id="excelImportHistoryBody">
                            <tr><td colspan="8" class="text-center text-muted py-3">No imports yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* ============ Professional Employee Listing UI ============ */

        /* Page Header */
        .emp-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
        }

        .emp-header-left h2.emp-page-title {
            font-size: 28px;
            font-weight: 700;
            color: #212121;
            margin-bottom: 4px;
        }

        .emp-page-subtitle {
            font-size: 13px;
            color: #666;
            margin: 0;
        }

        .emp-header-right {
            display: flex;
            gap: 12px;
        }

        .emp-count-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: linear-gradient(135deg, #00897b, #00695c);
            color: #fff;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 4px 12px rgba(0,137,123,.2);
        }

        .emp-count-badge i {
            font-size: 18px;
        }

        /* Controls Bar */
        .emp-controls-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            background: #f5f5f5;
            padding: 12px 16px;
            border-radius: 10px;
        }

        .emp-controls-left {
            display: flex;
            gap: 12px;
            align-items: center;
            flex: 0 1 auto;
        }

        .emp-search-wrapper {
            position: relative;
            width: 280px;
        }

        .emp-search-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 14px;
            pointer-events: none;
        }

        .emp-search-input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            background: #fff;
            transition: all .2s ease;
        }

        .emp-search-input:focus {
            outline: none;
        }

        .emp-entries-select {
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
            background: #fff;
            cursor: pointer;
            transition: all .2s ease;
        }

        .emp-entries-select:hover {
            border-color: #00897b;
        }

        .emp-controls-right {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

        .emp-btn-group {
            display: flex;
            gap: 4px;
        }

        /* Buttons */
        .emp-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 16px;
            border: 0;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
            white-space: nowrap;
        }

        .emp-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }

        .emp-btn-primary {
            background: linear-gradient(135deg, #00897b, #00695c);
            color: #fff;
        }

        .emp-btn-secondary {
            background: #f0f0f0;
            color: #424242;
        }

        .emp-btn-secondary:hover {
            background: #e0e0e0;
        }

        .emp-btn-info {
            background: #1976d2;
            color: #fff;
        }

        .emp-btn-danger {
            background: #ef5350;
            color: #fff;
        }

        .emp-btn-excel {
            background: linear-gradient(135deg, #43a047, #2e7d32);
            color: #fff;
        }

        /* Table Card */
        .emp-table-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
            overflow: hidden;
        }

        .emp-table-wrapper {
            overflow-x: auto;
        }

        .emp-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .emp-table thead {
            background: linear-gradient(135deg, #f5f5f5, #efefef);
            border-bottom: 2px solid #e0e0e0;
        }

        .emp-table thead tr th {
            padding: 14px;
            text-align: left;
            font-weight: 600;
            color: #424242;
            white-space: nowrap;
        }

        .emp-table tbody tr.emp-row {
            cursor: pointer;
            border-bottom: 1px solid #f0f0f0;
            transition: all .2s ease;
        }

        .emp-table tbody tr.emp-row:hover {
            background: #f9f9f9;
        }

        .emp-table tbody tr.emp-row.selected-row {
            background: linear-gradient(135deg, rgba(0,137,123,.1), rgba(0,137,123,.05));
            border-left: 4px solid #00897b;
        }

        .emp-table tbody td {
            padding: 12px 14px;
            color: #212121;
        }

        .emp-col-num {
            width: 40px;
            text-align: center;
            color: #999;
        }

        .emp-col-photo {
            width: 50px;
            text-align: center;
        }

        .emp-photo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e0e0e0;
            transition: all .2s ease;
        }

        .emp-table tbody tr.emp-row:hover .emp-photo {
            border-color: #00897b;
            box-shadow: 0 0 8px rgba(0,137,123,.2);
        }

        .emp-code-badge {
            display: inline-block;
            padding: 4px 10px;
            background: #e3f2fd;
            color: #1976d2;
            border-radius: 4px;
            font-weight: 600;
            font-size: 12px;
        }

        .emp-designation-badge {
            display: inline-block;
            padding: 4px 10px;
            background: #f3e5f5;
            color: #7b1fa2;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
        }

        .emp-email-link {
            color: #1976d2;
            text-decoration: none;
            transition: all .2s ease;
        }

        .emp-email-link:hover {
            text-decoration: underline;
            color: #0d47a1;
        }

        .emp-col-code,
        .emp-col-designation {
            text-align: center;
        }

        /* Row selection */
        #employeeListTable tbody tr.employee-row.selected-row,
        #employeeListTable tbody tr.employee-row.selected-row > td {
            background-color: rgba(0,137,123,.08) !important;
        }

        @@media (max-width: 768px) {
            .emp-page-header {
                flex-direction: column;
            }

            .emp-controls-bar {
                flex-direction: column;
            }

            .emp-controls-left,
            .emp-controls-right {
                width: 100%;
            }

            .emp-search-wrapper {
                width: 100%;
            }

            .emp-btn-group {
                width: 100%;
            }

            .emp-btn {
                flex: 1;
                justify-content: center;
            }
        }

        /* ----- Bulk import overlay (Professional Design) ----- */
        .excel-import-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.4);
            z-index: 1080;
            align-items: center;
            justify-content: center;
            overflow-y: auto;
            padding: 20px;
            backdrop-filter: blur(2px);
        }

        .excel-import-overlay.open { display: flex; }

        .excel-import-dialog {
            background: #fff;
            width: 100%;
            max-width: 800px;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,.15);
            overflow: hidden;
        }

        .excel-import-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 28px;
            background: linear-gradient(135deg, #00897b 0%, #00695c 100%);
            color: #fff;
        }

        .excel-import-header .d-flex {
            gap: 16px;
            align-items: center;
        }

        .excel-import-icon {
            width: 48px;
            height: 48px;
            background: rgba(255,255,255,.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .excel-import-header h4 {
            font-weight: 600;
            font-size: 18px;
        }

        .excel-import-header p {
            font-size: 13px;
            opacity: .9;
        }

        .excel-import-close {
            background: rgba(255,255,255,.2);
            border: 0;
            color: #fff;
            font-size: 28px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s ease;
        }

        .excel-import-close:hover {
            background: rgba(255,255,255,.3);
        }

        .excel-import-body {
            padding: 28px;
            max-height: 70vh;
            overflow-y: auto;
        }

        /* Alert styles */
        .excel-alert {
            padding: 12px 16px;
            border-radius: 8px;
            border-left: 4px solid;
        }

        .excel-alert-danger {
            background: #ffebee;
            border-color: #ef5350;
            color: #c62828;
        }

        /* Steps container */
        .excel-steps-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 24px;
        }

        @@media (max-width: 600px) {
            .excel-steps-container { grid-template-columns: 1fr; }
        }

        .excel-step-card {
            background: #f5f5f5;
            padding: 20px;
            border-radius: 10px;
            border: 1px solid #e0e0e0;
            position: relative;
            transition: all .3s ease;
        }

        .excel-step-card:hover {
            border-color: #00897b;
            background: #f1f9f8;
        }

        .excel-step-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #00897b, #00695c);
            color: #fff;
            border-radius: 50%;
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .excel-step-content h6 {
            color: #212121;
            font-weight: 600;
        }

        .excel-file-input {
            flex: 1;
            min-width: 200px;
            padding: 8px 12px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 13px;
        }

        /* Button styles */
        .excel-btn-primary,
        .excel-btn-success,
        .excel-btn-danger,
        .excel-btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border: 0;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all .2s ease;
        }

        .excel-btn-primary {
            background: #00897b;
            color: #fff;
        }

        .excel-btn-primary:hover {
            background: #00695c;
        }

        .excel-btn-success {
            background: #43a047;
            color: #fff;
        }

        .excel-btn-success:hover {
            background: #2e7d32;
        }

        .excel-btn-danger {
            background: #ef5350;
            color: #fff;
        }

        .excel-btn-danger:hover {
            background: #e53935;
        }

        .excel-btn-ghost {
            background: transparent;
            color: #00897b;
            border: 1px solid #00897b;
        }

        .excel-btn-ghost:hover {
            background: #00897b;
            color: #fff;
        }

        /* Progress section */
        .excel-progress-section {
            border-top: 1px solid #e0e0e0;
        }

        .excel-progress-bar-wrapper {
            height: 28px;
            background: #e0e0e0;
            border-radius: 14px;
            overflow: hidden;
            position: relative;
        }

        .excel-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #00897b, #00d9d0);
            width: 0%;
            transition: width .4s cubic-bezier(.4,0,.2,1);
            box-shadow: inset 0 0 10px rgba(0,0,0,.1);
        }

        .excel-progress-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            padding: 8px;
            background: #fafafa;
            border-radius: 6px;
            font-size: 13px;
        }

        .stat-label {
            color: #666;
        }

        .stat-value {
            font-weight: 600;
        }

        .excel-badge-primary {
            background: linear-gradient(135deg, #00897b, #00695c);
            color: #fff;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        /* Error section */
        .excel-error-section {
            background: #ffebee;
            border: 1px solid #ffcdd2;
            border-radius: 8px;
        }

        /* History section */
        .excel-history-section {
            border-top: 1px solid #e0e0e0;
        }

        .excel-history-table-wrapper {
            max-height: 280px;
            overflow-y: auto;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
        }

        .excel-history-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .excel-history-table thead {
            background: #f5f5f5;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .excel-history-table th {
            padding: 12px 8px;
            text-align: left;
            font-weight: 600;
            color: #424242;
            border-bottom: 1px solid #e0e0e0;
        }

        .excel-history-table td {
            padding: 10px 8px;
            border-bottom: 1px solid #f0f0f0;
        }

        .excel-history-table tbody tr:hover {
            background: #f9f9f9;
        }

        .excel-hist-file {
            font-weight: 500;
            color: #1976d2;
        }

        .excel-hist-date,
        .excel-hist-by {
            font-size: 12px;
            color: #666;
        }

        .excel-hist-success {
            color: #2e7d32;
            font-weight: 600;
        }

        .excel-hist-warn {
            color: #f57c00;
            font-weight: 600;
        }

        .excel-hist-error {
            color: #d32f2f;
            font-weight: 600;
        }

        .excel-history-download {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            background: #ef5350;
            color: #fff;
            border-radius: 50%;
            text-decoration: none;
            transition: all .2s ease;
