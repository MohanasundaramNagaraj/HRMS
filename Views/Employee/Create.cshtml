@model SparkHRMS.Data.Entities.Employee

@{
    ViewData["Title"] = "Create";
}

<link href="~/app/assets/css/form.min.css" rel="stylesheet">

<link href="~/app/assets/js/bundles/flatpicker/flatpickr.min.css" rel="stylesheet">


<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title"> Employees</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            <i class="fas fa-add"></i> Add
        </a>
    </li>
    @* <li class="breadcrumb-item bcrumb-1">
        <a href="../../index.html">
        <i class="fas fa-home"></i> Home
        </a>
        </li>
        <li class="breadcrumb-item bcrumb-2">
        <a href="#" onClick="return false;">Employees</a>
        </li>
        <li class="breadcrumb-item active">Add Employee</li> *@
</ul>
<hr />
<div class="card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="body">
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="EmployeeCode">
                                <label class="form-label">Employee Code</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Name">
                                <label class="form-label">Name</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <input type="text" class="form-control" asp-for="FatherName" />
                            <label class="form-label">Father's Name</label>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Gender">
                                <label class="form-label">Gender</label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input asp-for="Email" class="form-control" />
                                <label class="form-label">Email</label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Designation">
                                <label class="form-label">Designation</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       class="form-control datetimepicker"
                                       asp-for="DateOfJoining"
                                       id="date1"
                                       autocomplete="off" />
                                <label class="form-label">Date of joining</label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       maxlength="10"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'');" />
                                <label class="form-label">Telephone</label>
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       class="form-control datetimepicker"
                                       asp-for="DOB"
                                       id="date2"
                                       autocomplete="off" />
                                <label class="form-label">Date of Birth</label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Address">
                                <label class="form-label">Address</label>
                            </div>
                        </div>
                    </div>
                </div>





            </div>

            <div class="row clearfix">
                <div class="col-md-6" style="top: 8px;">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <input type="hidden"
                                   id="reportingHead"
                                   asp-for="ReportingHeadMailID" />

                            <select id="reportingHeadSelect"
                                    class="form-control select2"
                                    onchange="document.getElementById('reportingHead').value = this.value">
                                <option value=""></option>
                                @foreach (var name in ViewBag.ActiveUsers)
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>

                            <label class="form-label" style="margin-top: 0px; top: -10px">Reporting Head</label>
                        </div>
                    </div>
                </div>
                <div class="class= col-md-6  form-check">
                    <br />
                    <br />
                    <input asp-for="IsActive" class="form-check-input" value="true" checked />
                    <label class="form-check-label"style="bottom: 13px;left: 16px;">Is Active</label>
                </div>
            </div>
                @* <div class="row">
                <div class="col-sm-12">
                    <label class="control-label col-md-3">Upload Your Profile Photo</label>
                    <form action="/" id="frmFileUpload" class="dropzone" method="post"
                          enctype="multipart/form-data">
                        <div class="dz-message">
                            <div class="drag-icon-cph">
                                <i class="material-icons">touch_app</i>
                            </div>
                            <h3>Drop files here or click to upload.</h3>
                            <em>
                                (This is just a demo dropzone. Selected files are
                                <strong>not</strong>
                                actually uploaded.)
                            </em>
                        </div>
                        <div class="fallback">
                            <input name="file" asp-for="ImageUrl" type="file" multiple />
                        </div>
                    </form>
                </div>
            </div> *@
                <div class="col-lg-12 p-t-20 text-center">
                    <div class="form-group">
                        <input type="submit" value="Create" class="btn btn-primary waves-effect m-r-15" />
                        <a asp-action="Index" type="button" class="btn btn-danger waves-effect">Cancel</a>
                    </div>
                </div>

            </div>
</form>
</div>

<!-- Include jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- Include SweetAlert from CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script src="~/app/assets/js/bundles/dropzone.js"></script>
<script src="~/app/assets/js/bundles/flatpicker/flatpicker.min.js"></script>

<script src="~/app/assets/js/pages/forms/selectitem-data.js"></script>
<script src="~/app/assets/js/pages/forms/flatpicker-data.js"></script>
<script src="~/app/assets/js/pages/forms/dropzone-data.js"></script>
