@model SparkHRMS.Data.Entities.Employee

@{
    ViewData["Title"] = "Edit";
}

<link href="~/app/assets/css/form.min.css" rel="stylesheet">

<link href="~/app/assets/js/bundles/flatpicker/flatpickr.min.css" rel="stylesheet">
<style>
    .breadcrumb-item.ms-auto::before {
        content: none !important;
    }

</style>
<ul class="breadcrumb breadcrumb-style d-flex align-items-center">
    <li class="breadcrumb-item">
        <h4 class="page-title mb-0">Edit Employees</h4>
    </li>

    <li class="breadcrumb-item bcrumb-1">
        <a href="#">Edit</a>
    </li>

    <!-- Right side name -->
    <li class="breadcrumb-item ms-auto"  style="list-style:none;">
        <h4 class="mb-0">@Model.Name</h4>
    </li>
</ul>

<hr />

<div class="card">
    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="EmployeeId" />
        <div class="body">
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="EmployeeCode">
                                <label class="form-label">EmployeeCode</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Name">
                                <label class="form-label">Name</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <input type="text" class="form-control" asp-for="FatherName" />
                            <label class="form-label">FatherName</label>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <input type="text" class="form-control" name="Gender" asp-for="Gender" />
                            <label class="form-label">Gender</label>
                        </div>
                    </div>
                </div>

            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input asp-for="Email" class="form-control" />
                                <label class="form-label">Email</label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Designation">
                                <label class="form-label">Designation</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       class="form-control datetimepicker"
                                       asp-for="DateOfJoining"
                                       id="date1"
                                       autocomplete="off" />
                                <label class="form-label">Date of joining</label>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       maxlength="10"
                                       oninput="this.value=this.value.replace(/[^0-9]/g,'');" />
                                <label class="form-label">Telephone</label>
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="row clearfix">
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       class="form-control datetimepicker"
                                       asp-for="DOB"
                                       id="date2"
                                       autocomplete="off" />
                                <label class="form-label">Date of Birth</label>
                            </div>



                        </div>
                    </div>

                </div>

                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text" class="form-control" asp-for="Address">
                                <label class="form-label">Address</label>
                            </div>
                        </div>
                    </div>
                </div>



            </div>
            <div class="row clearfix">
                <div class="col-md-6" style="top: 8px;">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <input type="hidden"
                                   id="reportingHead"
                                   asp-for="ReportingHeadMailID" />
                            <select id="reportingHeadSelect"
                                    class="form-control select2"
                                    onchange="document.getElementById('reportingHead').value = this.value">

                                <option value="">-- Select Reporting Head --</option>

                                @foreach (var name in ViewBag.ActiveUsers)
                                {
                                    if (name == Model.ReportingHeadMailID)
                                    {
                                        <option value="@name" selected="selected">@name</option>
                                    }
                                    else
                                    {
                                        <option value="@name">@name</option>
                                    }
                                }
                            </select>


                            <label class="form-label" style="margin-top: 0px; top: -10px">Reporting Head</label>
                        </div>
                    </div>
                </div>
                <div class="class= col-md-6  form-check">
                    <br />
                    <br />
                    <input asp-for="IsActive" class="form-check-input" value="true" checked />
                    <label class="form-check-label" style="bottom: 13px;left: 16px;">Is Active</label>
                </div>
            </div>
