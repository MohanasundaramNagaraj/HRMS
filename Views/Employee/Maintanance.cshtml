@model SparkHRMS.ViewModels.EmployeeDetails

@{
    ViewData["Title"] = "Maintanance";
}

@{
    bool isView = Model.FMode == "VIEW";
    bool isEdit = Model.FMode == "EDIT";
    bool isAdd = Model.FMode == "ADD";
}


<link href="~/app/assets/css/form.min.css" rel="stylesheet">

<link href="~/app/assets/js/bundles/flatpicker/flatpickr.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<script src="~/js/Maintanance.js"></script>

<style>
    .identity-header {
        background-color: #009688;
        color: #fff;
        cursor: pointer;
        padding: 14px 18px;
        border-radius: 8px 8px 0 0;
        font-family: 'Montserrat', 'Segoe UI', sans-serif;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        font-size: 15px;
    }

    .view-mode {
        background-color: #fff !important;
        color: #000 !important;
        pointer-events: none;
    }


    .identity-header.collapsed .toggle-icon {
        transform: rotate(-90deg);
    }

    .toggle-icon {
        transition: transform 0.3s ease;
    }

    .form-float select.form-control {
        border: none;
        border-bottom: 1px solid #ddd;
        background: transparent;
        box-shadow: none;
    }

    select.form-control {
        display: block;
        height: 34px;
    }
        .form-float select.form-control:focus {
            border-bottom: 2px solid #ff9800;
            outline: none;
        }

    select.form-control {
        appearance: auto;
    }
    .breadcrumb-item.ms-auto::before {
        content: none !important;
    }
</style>
@if (isAdd)
{
    <ul class="breadcrumb breadcrumb-style d-flex align-items-center">
        <li class="breadcrumb-item">
            <h4 class="page-title mb-0">Add Employees</h4>
        </li>

        <li class="breadcrumb-item bcrumb-1">
            <a href="#">Add</a>
        </li>


    </ul>
}
@if (isEdit)
{
    <ul class="breadcrumb breadcrumb-style d-flex align-items-center">
        <li class="breadcrumb-item">
            <h4 class="page-title mb-0">Edit Employees</h4>
        </li>

        <li class="breadcrumb-item bcrumb-1">
            <a href="#">Edit</a>
        </li>

        <!-- Right side name -->
        <li class="breadcrumb-item ms-auto" style="list-style:none;">
            <h4 class="mb-0">@Model.EmployeeName - @Model.EmployeeCode</h4>
        </li>
    </ul>
}
@if(isView)
{
    <ul class="breadcrumb breadcrumb-style d-flex align-items-center">
        <li class="breadcrumb-item">
            <h4 class="page-title mb-0">View Employees</h4>
        </li>

        <li class="breadcrumb-item bcrumb-1">
            <a href="#">View</a>
        </li>

        <!-- Right side name -->
        <li class="breadcrumb-item ms-auto" style="list-style:none;">
            <h4 class="mb-0">@Model.EmployeeName - @Model.EmployeeCode</h4>
        </li>
    </ul>

}

<div id="employee">
    <div class="card shadow-sm mb-3">


        <div class="card-header identity-header text-white"
             data-bs-toggle="collapse"
             data-bs-target="#identityInfo"
             aria-expanded="true"
             style="cursor:pointer;">

            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-person-badge me-2"></i>
                    Identity Information
                </h5>
                <i class="bi bi-chevron-down toggle-icon"></i>
            </div>
        </div>



        <div id="identityInfo" class="collapse show">
            <div class="card-body" style="padding-top: 37px;padding-bottom: 45px;">

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <div class="form-group form-float">
                                <div class="form-line">

                                    <input type="hidden" id="hdnEmployeeId" value="@Model.EmployeeId" />

                                    @if (isView)
                                    {
                                        <input asp-for="EmployeeCode" class="form-control" readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="EmployeeCode" class="form-control" />
                                    }

                                    <label class="form-label">Employee Code</label>

                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="EmployeeName" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="EmployeeName" class="form-control" />
                                }
                                <label class="form-label">
                                    <i class="bi bi-person"></i> Full Name
                                    <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input type="text" class="form-control" value="@Model.Gender" readonly />
                                }
                                else
                                {
                                    <select class="form-control select2 gender-select" asp-for="Gender">
                                        <option value=""></option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                }



                                <label class="form-label">
                                    <i class="bi bi-gender-ambiguous"></i> Gender
                                    <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>



                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="DOB"
                                           type="text"
                                           class="form-control datetimepicker view-mode"
                                           readonly
                                           id="date2"
                                           autocomplete="off" />
                                }
                                else
                                {
                                    <input asp-for="DOB"
                                           type="text"
                                           class="form-control datetimepicker"
                                           id="date2"
                                           autocomplete="off" />
                                }

                                <label class="form-label">
                                    <i class="bi bi-calendar-event"></i>
                                    Date of Birth
                                </label>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="number" id="age" class="form-control" readonly>
                                <label class="form-label">
                                    <i class="bi bi-person-circle age-icon"></i>
                                    Age
                                    <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">

                                @if (isView)
                                {
                                    <input asp-for="BloodGroup"
                                           type="text"
                                           class="form-control"
                                           readonly />
                                }
                                else
                                {
                                    <select asp-for="BloodGroup"
                                            class="form-control blood-group"
                                            required>
                                        <option value=""></option>
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                    </select>
                                }

                                <label class="form-label">Blood Group</label>

                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="DateOfJoining"
                                           type="text"
                                           class="form-control datetimepicker view-mode"
                                           readonly
                                           id="date2"
                                           autocomplete="off" />
                                }
                                else
                                {
                                    <input asp-for="DateOfJoining"
                                           type="text"
                                           class="form-control datetimepicker"
                                           id="date2"
                                           autocomplete="off" />
                                }

                                <label class="form-label">
                                    <i class="bi bi-calendar-event"></i>
                                    Date Of Joining
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input type="text" class="form-control" value="@Model.Nationality" readonly />
                                }
                                else
                                {
                                    <select class="form-control select2 nationality" asp-for="Nationality">
                                        <option value=""></option>
                                        <option value="Indian">Indian</option>
                                        <option value="Others">Others</option>
                                    </select>
                                }

                                <label class="form-label">
                                    <i class="bi bi-flag"></i>
                                    Nationality <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    @if (isView)
                                    {
                                        <input asp-for="Designation" class="form-control" readonly />
                                    }
                                    else
                                    {
                                        <input asp-for="Designation" class="form-control" />
                                    }
                                    <label class="form-label">Designation</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <div class="form-group form-float">
                                <div class="form-line">
                                    @if (isView)
                                    {
                                        <input asp-for="ReportingHeadMailID"
                                               class="form-control"
                                               readonly />
                                    }
                                    else
                                    {
                                        <select asp-for="ReportingHeadMailID"
                                                class="form-control select2"
                                                id="reportingHeadSelect">
                                            <option value=""></option>
                                            @foreach (var name in ViewBag.ActiveUsers)
                                            {
                                                <option value="@name">@name</option>
                                            }
                                        </select>
                                    }
                                    <label class="form-label">Reporting Head</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input type="text" class="form-control" value="@Model.MartialStatus" readonly />
                                }
                                else
                                {
                                    <select class="form-control select2 marital-status" asp-for="MartialStatus">
                                        <option value=""></option>
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Divorced">Divorced</option>
                                        <option value="Widowed">Widowed</option>
                                    </select>
                                }

                                <label class="form-label">
                                    <i class="bi bi-heart"></i>
                                    Marital Status <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4 mt-3">
                        <label class="form-label"><i class="bi bi-camera"></i> Photograph</label>
                        <input type="file" id="Photo" name="Photo" />

                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">


        <div class="card-header identity-header collapsed"
             data-bs-toggle="collapse"
             data-bs-target="#contactInfo"
             aria-expanded="false">

            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center">
                    <span class="icon-box me-2">
                        <i class="bi bi-telephone"></i>
                    </span>
                    Contact Information
                </h5>
                <i class="bi bi-chevron-down toggle-icon"></i>
            </div>
        </div>


        <div id="contactInfo" class="collapse">
            <div class="card-body" style="padding-top: 37px;padding-bottom: 35px;">

                <div class="row">


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="PhoneNumber" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'');" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="PhoneNumber" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'');" class="form-control" />
                                }
                                <label class="form-label">
                                    <i class="bi bi-telephone"></i>
                                    Personal Mobile Number <span class="text-danger">*</span>
                                </label>
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="AlternateMoblieNumber" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="AlternateMoblieNumber" class="form-control" />
                                }
                                <label class="form-label">
                                    <i class="bi bi-telephone"></i>
                                    Alternate Mobile Number
                                </label>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="Email" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="Email" class="form-control" />
                                }


                                <label class="form-label">
                                    <i class="bi bi-envelope"></i>
                                    Personal Email ID <span class="text-danger">*</span>
                                </label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">


        <div class="card-header identity-header collapsed"
             data-bs-toggle="collapse"
             data-bs-target="#addressInfo"
             aria-expanded="false">

            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center">
                    <span class="icon-box me-2">
                        <i class="bi bi-geo-alt"></i>
                    </span>
                    Address Information
                </h5>
                <i class="bi bi-chevron-down toggle-icon"></i>
            </div>
        </div>

        <!-- BODY -->
        <div id="addressInfo" class="collapse">
            <div class="card-body" style="padding-top:37px;padding-bottom:35px;">

                <!-- ================= CURRENT ADDRESS ================= -->
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-house-door"></i> Current Address
                </h6>

                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       id="cAddress1"
                                       value="@(Model.CurrentAddress?.Address1 ?? "")"
                                       @(isView ? "readonly" : "")
                                       class="form-control">

                                <label class="form-label">
                                    <i class="bi bi-house"></i> Address Line 1 <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       class="form-control"
                                       id="cAddress2"
                                       value="@(Model.CurrentAddress?.Address2 ?? "")"
                                       @(isView ? "readonly" : "") />
                                <label class="form-label">
                                    <i class="bi bi-building"></i> Address Line 2
                                </label>
                            </div>

                        </div>
                    </div>

                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       id="cCity"
                                       value="@(Model.CurrentAddress?.City ?? "")"
                                       @(isView ? "readonly" : "")
                                       class="form-control">
                                <label class="form-label">
                                    City <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input type="text"
                                           class="form-control"
                                           id="cState"
                                            asp-for="CurrentAddress.StateID"
                                           readonly />
                                }
                                else
                                {
                                    <select id="cState"
                                            asp-for="CurrentAddress.StateID"
                                            class="form-control select2">
                                        <option value=""></option>
                                        <option value="1">Tamil Nadu</option>
                                        <option value="2">Kerala</option>
                                    </select>
                                }
                                <label class="form-label">State</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input type="text" class="form-control" value="@Model.CurrentAddress?.Country" readonly />
                                }
                                else
                                {
                                    <select id="cCountry"
                                            asp-for="CurrentAddress.Country"
                                            class="form-control select2">

                                        <option value=""></option>
                                        <option value="India">India</option>

                                    </select>
                                }
                                <label class="form-label">Country</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mt-3">
                        <div class="form-group form-float">
                            <div class="form-line">
                                <input type="text"
                                       id="cPincode"
                                       value="@(Model.CurrentAddress?.Pincode ?? "")" @(isView ? "readonly" : "")
                                       maxlength="6"
                                       class="form-control">
                                <label class="form-label">
                                    <i class="bi bi-mailbox"></i> Pincode <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- SAME AS CURRENT -->
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="sameAddress" name="IsSameAsCurrent">
                    <label class="form-check-label" for="sameAddress">
                        Permanent Address same as Current Address
                    </label>
                </div>



                <hr class="my-4">

                <!-- ================= PERMANENT ADDRESS ================= -->
                <h6 class="fw-semibold mb-3">
                    <i class="bi bi-house-check"></i> Permanent Address
                </h6>

                <div class="row">

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="pAddress1" class="form-label">
                                <i class="bi bi-house"></i> Address Line 1
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="pAddress1"
                                   value="@(Model.PermanentAddress?.Address1 ?? "")" @(isView ? "readonly" : "")
                                   class="form-control">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="pAddress2" class="form-label">
                                <i class="bi bi-building"></i> Address Line 2
                            </label>
                            <input type="text"
                                   id="pAddress2"
                                   value="@(Model.PermanentAddress?.Address2 ?? "")" @(isView ? "readonly" : "")
                                   class="form-control">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="pCity" class="form-label">
                                City <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="pCity"
                                   value="@(Model.PermanentAddress?.City ?? "")" @(isView ? "readonly" : "")
                                   class="form-control">
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="pState" class="form-label">State</label>
                            @if (isView)
                            {
                                <input type="text" class="form-control" value="@Model.PermanentAddress?.StateID" readonly />
                            }
                            else
                            {
                                <select id="pState"
                                        asp-for="PermanentAddress.StateID"
                                        class="form-control select2">

                                    <option value=""></option>
                                    <option value="1">Tamil Nadu</option>
                                    <option value="2">Kerala</option>
                                </select>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="pCountry" class="form-label">Country</label>
                            @if (isView)
                            {
                                <input type="text" class="form-control" value="@Model.PermanentAddress?.Country" readonly />
                            }
                            else
                            {
                                <select id="pCountry"
                                        asp-for="PermanentAddress.Country"
                                        class="form-control select2">
                                    <option value=""></option>
                                    <option value="India">India</option>
                                </select>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="pPincode" class="form-label">
                                <i class="bi bi-mailbox"></i> Pincode
                                <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="pPincode"
                                   value="@(Model.PermanentAddress?.Pincode ?? "")" @(isView ? "readonly" : "")
                                   maxlength="6"
                                   class="form-control">
                        </div>
                    </div>

                </div>


            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">


        <div class="card-header identity-header collapsed"
             data-bs-toggle="collapse"
             data-bs-target="#emergencyContact"
             aria-expanded="false">

            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center">
                    <span class="icon-box me-2">
                        <i class="bi bi-person-lines-fill"></i>
                    </span>
                    Emergency Contact Information
                </h5>
                <i class="bi bi-chevron-down toggle-icon"></i>
            </div>
        </div>


        <div id="emergencyContact" class="collapse">
            <div class="card-body" style="padding-top:37px;padding-bottom:35px;">

                <div class="row">


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="EmergencyContactName" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="EmergencyContactName" class="form-control" />
                                }
                                <label class="form-label">
                                    <i class="bi bi-person"></i>
                                    Contact Person Name <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">

                                @if (isView)
                                {
                                    <input asp-for="EmergencyContactRelation"
                                           class="form-control"
                                           readonly />
                                }
                                else
                                {
                                    <select asp-for="EmergencyContactRelation"
                                            id="EmergencyContactRelation"
                                            class="form-control select2 emergency-relation">
                                        <option value="">Select Relationship</option>
                                        <option value="Father">Father</option>
                                        <option value="Mother">Mother</option>
                                        <option value="Sibling">Sibling</option>
                                        <option value="Spouse">Spouse</option>
                                        <option value="Friend">Friend</option>
                                    </select>
                                }

                                <label class="form-label">
                                    <i class="fa fa-users"></i> Relationship
                                </label>

                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="EmergencyContactNumber" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'');" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="EmergencyContactNumber" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'');" class="form-control" />
                                }
                                <label class="form-label">
                                    <i class="bi bi-telephone"></i>
                                    Contact Number <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group form-float">
                            <div class="form-line">
                                @if (isView)
                                {
                                    <input asp-for="EmergencyAlternateNumber" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'');" class="form-control" readonly />
                                }
                                else
                                {
                                    <input asp-for="EmergencyAlternateNumber" maxlength="10" oninput="this.value=this.value.replace(/[^0-9]/g,'');" class="form-control" />
                                }
                                <label class="form-label">
                                    <i class="bi bi-telephone"></i>
                                    Alternate Contact Number <span class="text-danger">*</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
