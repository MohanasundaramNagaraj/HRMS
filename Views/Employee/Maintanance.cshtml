<script>
    // Passport Expiry uses its own id (the shared #date2 picker only covers DOB
    // and Date of Joining), so initialise flatpickr for it with the same d-m-Y format.
    $(function () {
        if (typeof flatpickr === "function") {
            flatpickr("input[name='PassportExpiryDate']", {
                allowInput: true,
                dateFormat: "d-m-Y",
                onOpen: function (selectedDates, dateStr, instance) {
                    instance.setDate(instance.input.value, false);
                }
            });
        }
    });

    // Auto-calculate Age from Date of Birth.
    $(function () {
        // DOB input uses flatpickr with format d-m-Y (e.g. 10-06-2026).
        var dobEl = document.querySelector('input[name="DOB"]');
        var $age = $('#age');
        if (!dobEl) return;

        function calculateAge(dobStr) {
            if (!dobStr) return '';
            var parts = dobStr.split('-');
            if (parts.length !== 3) return '';
            var day = parseInt(parts[0], 10);
            var month = parseInt(parts[1], 10);
            var year = parseInt(parts[2], 10);
            if (!day || !month || !year) return '';

            var dob = new Date(year, month - 1, day);
            if (isNaN(dob.getTime())) return '';

            var today = new Date();
            var age = today.getFullYear() - dob.getFullYear();
            var monthDiff = today.getMonth() - dob.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                age--;
            }
            // Guard against a future DOB.
            return age >= 0 ? age : '';
        }

        function updateAge() {
            var age = calculateAge(dobEl.value);
            $age.val(age);
            // Toggle the floating-label ".focused" class so the "Age" label moves up
            // and reveals the value when present, and rests in place when empty.
            $age.closest('.form-line').toggleClass('focused', age !== '');
        }

        // admin.js floats a field's label on focus regardless of its value. The Age
        // field is readonly but still clickable/focusable, which would float an empty
        // label and leave it misaligned with its row neighbours. Keep it resting when
        // there is no calculated value.
        $age.on('focus', function () {
            if (!$age.val()) {
                $age.closest('.form-line').removeClass('focused');
            }
        });

        // Hook flatpickr's own callbacks (fires whether the date is picked from
        // the calendar or typed in). flatpicker-data.js initializes it first.
        if (dobEl._flatpickr) {
            dobEl._flatpickr.config.onChange.push(updateAge);
            dobEl._flatpickr.config.onValueUpdate.push(updateAge);
            dobEl._flatpickr.config.onClose.push(updateAge);

            // Any date is selectable; when the user picks a date that makes the
            // employee under 18 (measured from today), show the validation error
            // immediately. Server-side validation also enforces this.
            dobEl._flatpickr.config.onChange.push(function () {
                if (typeof validateDobAge === "function") {
                    validateDobAge();
                }
            });
        }

        // Fallbacks for manual typing / non-flatpickr cases.
        $(dobEl).on('change blur keyup input', updateAge);

        // Prefill in edit/view mode when a DOB already exists.
        if (dobEl.value) {
            updateAge();
        }
    });
</script>
