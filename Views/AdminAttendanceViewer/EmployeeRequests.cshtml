@using Microsoft.AspNetCore.Identity
@using SparkHRMS.Data.Entities
@using SparkHRMS.Utilities
@using SparkHRMS.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Employee Attendance Request";
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
}

<link href="~/app/assets/css/bundles/dataTables.bootstrap5.min.css" rel="stylesheet">

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title">Employee Request</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            Requests
        </a>
    </li>
</ul>

<div class="row clearfix">
    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
    {
        <div class="col-md-12 mb-3">
            <div>
                <div class="">
                    <select id="yearSelector" style="width:20%; margin-right:10px; display:inline-block">
                        <option value="">Select Year</option>
                        @for (int year = DateTime.Now.Year; year >= DateTime.Now.Year - 10; year--)  
                        {
                            if (year == ViewBag.SelectedYear)
                            {
                                <option value="@year" selected>@year</option>
                            }
                            else
                            {
                                <option value="@year">@year</option>
                            }
                        }
                    </select>
                    <select id="monthSelector" style="width:20%;margin-right:10px;display:inline-block">
                        <option value="">Select Month</option>
                        @for (int month = 1; month <= 12; month++)
                        {
                            if (month == ViewBag.SelectedMonth)
                            {
                                <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                            else
                            {
                                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                        }
                    </select>
                    <select style="width:35%;margin-right:10px;display:inline-block" id="empSelector">
                        @{
                            var employeeList = ViewBag.EmployeeList;
                        }

                        @foreach (var record in employeeList)
                        {
                            if (ViewBag.SelectedEmployeeID == record.EmployeeId)
                            {
                                <option value="@record.EmployeeId" selected>@record.EmployeeCode - @record.Name</option>
                            }
                            else
                            {
                                <option value="@record.EmployeeId">@record.EmployeeCode - @record.Name</option>
                            }
                        }
                    </select>
                    <button onclick="getData()" class="btn btn-info">
                        Filter
                    </button>
                </div>
            </div>
        </div>
    }
    <div class="action-buttons d-none">
        <button id="approveButton" class="btn btn-success">Approve</button>
        <button id="holdButton" class="btn btn-warning">Hold</button>
        <button id="rejectButton" class="btn btn-danger">Reject</button>
    </div>
    <div id="recordModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Review Selected Records</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- Top Bar: Displays Selected Record Data -->
                    <div id="topBar" class="mb-3">
                        <p><strong>Employee Code:</strong> <span id="topEmpCode"></span></p>
                        <p><strong>Employee Name:</strong> <span id="topEmpName"></span></p>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <!-- Left Tabs -->
                            <ul class="nav nav-tabs flex-column" id="leftTabs" role="tablist"></ul>
                        </div>
                        <div class="col-md-8">
                            <!-- Tab Content -->
                            <div class="tab-content" id="leftTabsContent"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <textarea id="comments" class="form-control" rows="3" placeholder="Enter your comments here..."></textarea>
                    <button id="approveButton" class="btn btn-success">Approve</button>
                    <button id="holdButton" class="btn btn-warning">Hold</button>
                    <button id="rejectButton" class="btn btn-danger">Reject</button>
                </div>
            </div>
        </div>
    </div>


    <div class="col-lg-12 col-md-12">
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="project" aria-expanded="true">
                <div class="row clearfix">

                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class="card project_widget">
                            <div class="header">
                            </div>
                            <div class="body">
                                <div class="row">
                                    <div class="table-responsive">
                                        <table class="table table-hover js-basic-example contact_list">
                                            <thead>
                                                <tr>
                                                    <th class="center">
                                                        <input type="checkbox" id="selectAll" style="">
                                                    </th>
                                                    <th class="center"> Employee Code </th>
                                                    <th class="center"> Employee Name </th>
                                                    <th class="center"> Request Type </th>
                                                    <th class="center"> Request Date & Time </th>
                                                    <th class="center"> Reason </th>
                                                    <th class="center"> Approval Status </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                
                                                @foreach (var record in Model)
                                                {
                                                    <tr class="odd gradeX">
                                                        <td>
                                                            @if (@record.ApprovalStatus == @Constants.RequestStatuses.Pending)
                                                            {
                                                                <input type="checkbox" id="@record.EmpCode">
                                                            }
                                                        </td>
                                                        <td>@record.EmpCode</td>  
                                                        <td>@record.Name</td>
                                                        <td>@record.RequestType</td>
                                                        <td>@record.RequestDateTime</td>
                                                        <td>@record.Reason</td>
                                                        <td>@record.ApprovalStatus</td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- Include jQuery -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <!-- Include SweetAlert from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @*  <script src="~/app/assets/js/common.min.js"></script> *@
    <script src="~/app/assets/js/table.min.js"></script>

 
    <script src="~/js/employeerequests.js"></script>
}