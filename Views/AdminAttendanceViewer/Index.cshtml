@using SparkHRMS.ViewModels;
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using System.Globalization
@{
    ViewData["Title"] = "Employee Attendance";
    var selectedDate = ViewBag.SelectedDate.ToString("yyyy-MM-dd");
    var employeeName = ViewBag.EmployeeName ?? "";
}

<style>
    .table thead tr th {
        padding: 10px;
        border-bottom: 2px solid #dee2e6 !important;
    }
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
<script>
    function downloadExcel() {
        var table = document.querySelector("table");

        // Clone to avoid affecting UI
        var clone = table.cloneNode(true);

        // Remove last column from all rows
        for (let row of clone.rows) {
            row.deleteCell(row.cells.length - 1);
        }

        var title = document.querySelector(".card-header h5").innerText;

        var wb = XLSX.utils.table_to_book(clone, { sheet: "Attendance" });
        XLSX.writeFile(wb, title.replaceAll(" ", "_") +".xlsx");
    }


    function downloadPDF() {
        const { jsPDF } = window.jspdf;
        var doc = new jsPDF('l', 'pt', 'a4');

        // Get dynamic title from your H5
        var title = document.querySelector(".card-header h5").innerText;

        doc.text(title, 40, 40);

        // Clone table & remove last column
        var table = document.querySelector("table");
        var clone = table.cloneNode(true);

        for (let row of clone.rows) {
            row.deleteCell(row.cells.length - 1);
        }

        doc.autoTable({
            html: clone,
            startY: 60,
            theme: 'grid',
            styles: { fontSize: 8 },
            headStyles: { fillColor: [52, 73, 94] }
        });

        doc.save(title.replaceAll(" ", "_") + ".pdf");
    }
</script>



<div class="container mt-4">
    <ul class="breadcrumb breadcrumb-style ">
        <li class="breadcrumb-item">
            <h4 class="page-title"> Attendance</h4>
        </li>
        <li class="breadcrumb-item bcrumb-1">
            <a href="#">
                <i class="fas fa-add"></i> Employee Attendance
            </a>
        </li>

    </ul>
    <hr />
    <div class="">
        <!-- Date Filter -->
        <div class="col-md-12 mb-3">
            <form>
                <div class="row">
                    <input type="date" name="date" value="@selectedDate" class="form-control" style="width:35%;margin-right:10px;" />
                    <button type="submit" class="btn btn-info" style="width:10%;margin-right:10px;">Filter</button>

                    <button class="btn btn-success" onclick="downloadExcel()" style="width:10%;margin-right:10px;float:right">Download Excel</button>
                    <button class="btn btn-danger" onclick="downloadPDF()" style="width:10%;margin-right:10px;float:right">Download PDF</button>

                </div>
            </form>
        </div>

        <!-- Attendance Data Table -->
        <div>
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5>Employee Attendance for @ViewBag.SelectedDate.ToString("dd MMM yyyy")</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                      
                        <thead>
                            <tr>
                                <th rowspan="2">Employee Name</th>
                                <th rowspan="2">Permission/Leave/On Duty Details</th>
                                <th colspan="2" class="text-center">Working Details</th>
                                <th colspan="3" class="text-center">Check In Details</th>
                                <th colspan="3" class="text-center">Check Out Details</th>
                                <th rowspan="2">Actions</th>
                            </tr>

                            <tr>
                                <!-- Sub Columns -->
                                <th>Working Time</th>
                                <th>Working Hours</th>

                                <th>Made IP</th>
                                <th>Made By</th>
                                <th>Made Time</th>

                                <th>Made IP</th>
                                <th>Made By</th>
                                <th>Made Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {

                                string displayText = string.Empty;
                                string displayTextColor = string.Empty;
                                string onDutyDisplayText = string.Empty;
                                string onDutyDisplayTextColor = string.Empty;

                                if (record.IsLeave || record.IsPermission || record.IsOnDuty || record.IsHalfDayLeave)
                                {
                                    if (record.IsLeave)
                                    {
                                        displayText = "\n Leave";
                                    }

                                    if (!record.IsLeave && record.IsHalfDayLeave
                                    //&& record.HalfDayLeave.HasValue
                                    )
                                    {
                                        displayText += $"\n Half Day Leave";
                                    }

                                    if (!record.IsLeave && record.IsPermission)
                                    {
                                        DateTime? permissionStart = record?.PermissionStartTime as DateTime?;
                                        DateTime? permissionEnd = record?.PermissionEndTime as DateTime?;

                                        var permissionTime = (permissionStart.HasValue && permissionStart.Value.TimeOfDay != TimeSpan.Zero)
                                        ? permissionStart.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                        : "";

                                        var permissionEndTime = (permissionEnd.HasValue && permissionEnd.Value.TimeOfDay != TimeSpan.Zero)
                                        ? permissionEnd.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                        : "";

                                        displayText += "\n Permission on " + $"{permissionTime} - {permissionEndTime}";
                                    }
                                    displayTextColor = "red";

                                    if (!record.IsLeave && record.IsOnDuty)
                                    {
                                        DateTime? Start = record?.DutyStartTime as DateTime?;
                                        DateTime? End = record?.DutyEndTime as DateTime?;

                                        var StartTime = (Start.HasValue && Start.Value.TimeOfDay != TimeSpan.Zero)
                                        ? Start.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                        : "";

                                        var EndTime = (End.HasValue && End.Value.TimeOfDay != TimeSpan.Zero)
                                        ? End.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                        : "";

                                        onDutyDisplayText += "\n On Duty on " + $"{StartTime} - {EndTime}";
                                        onDutyDisplayTextColor = "black";
                                    }


                                }

                                DateTime? checkIn = record?.CheckInDateTime as DateTime?;
                                DateTime? checkOut = record?.CheckOutDateTime as DateTime?;

                                var checkInTime = (checkIn.HasValue && checkIn.Value.TimeOfDay != TimeSpan.Zero)
                                ? checkIn.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                : "";

                                var checkOutTime = (checkOut.HasValue && checkOut.Value.TimeOfDay != TimeSpan.Zero)
                                ? checkOut.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                : "";

                                var checkIndisplayText = $"{checkInTime} - {checkOutTime}";

                                <tr>
                                    <td>@(record.EmployeeName ?? "N/A")</td>
                                    <td>
                                        <span style=" text-align: center !important; display: block; color:@displayTextColor">
                                            @displayText<br />

                                        </span>
                                        <span style=" text-align: center !important; display: block; color:@onDutyDisplayTextColor">
                                            @onDutyDisplayText<br />

                                        </span>
                                    </td>
                                    <td class="center" style="width: 200px !important;
                                                                                              max-width: 300px !important;
                                                                                              min-width: 200px !important;
                                                                                              word-wrap: anywhere;">
                                        @checkIndisplayText
                                        <br />
                                        @record.CheckInLocation
                                    </td>

                                    <td>@( (record.IsLeave) ? "-" : record.WorkingHours ?? "N/A")</td>
                                    <td>
                                        @{
                                            var checkInMadeDateTime = record?.CheckInMadeDateTime as DateTime?;
                                            var checkInMadeTime = (checkInMadeDateTime.HasValue && checkInMadeDateTime.Value.TimeOfDay != TimeSpan.Zero)
                                            ? checkInMadeDateTime.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                            : "";
                                        }
                                        @* @if (checkInMadeTime != string.Empty)
                                        {
                                            <span> IP: <b>@record.IP</b> <br /></span>
                                            <span> Made By: <b>@record.CheckInMadeBy</b> <br /></span>
                                            <span> Time: <b>@checkInMadeTime </b><br />
                                            </span>
                                        } *@
                                        @if (checkInMadeTime != string.Empty)
                                        {
                                            <b>@record.IP</b>
                                        }

                                    </td>
                                    <td>
                                        @if (checkInMadeTime != string.Empty)
                                        {
                                            <b>@record.CheckInMadeBy</b>
                                        }
                                    </td>
                                    <td>
                                        @if (checkInMadeTime != string.Empty)
                                        {
                                            <b>@checkInMadeTime </b>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var checkOutMadeDateTime = record?.CheckOutMadeDateTime as DateTime?;
                                            var checkOutMadeTime = (checkOutMadeDateTime.HasValue && checkOutMadeDateTime.Value.TimeOfDay != TimeSpan.Zero)
                                            ? checkOutMadeDateTime.Value.ToString("hh:mm tt", CultureInfo.InvariantCulture)
                                            : "";
                                        }

                                       @*  @if (checkOutMadeTime != string.Empty)
                                        {
                                            <span> IP: <b>@record.IP</b> <br /></span>
                                            <span> Made By: <b>@record.CheckOutMadeBy</b> <br /></span>
                                            <span>
                                                Time: <b>@checkOutMadeTime</b> <br />
                                            </span>
                                        } *@
                                        @if (checkOutMadeTime != string.Empty)
                                        {
                                            <b>@record.IP</b>
                                        }
                                    </td>
                                    <td>
                                        @if (checkOutMadeTime != string.Empty)
                                        {
                                            <b>@record.CheckOutMadeBy</b>
                                        }
                                    </td>
                                    <td>
                                        @if (checkOutMadeTime != string.Empty)
                                        {
                                            <b>@checkOutMadeTime </b>
                                        }
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Add", new { EmployeeId = record.EmployeeId, date = ViewBag.SelectedDate })" class="btn btn-warning btn-sm p-t-10">
                                            <i class="material-icons">create</i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
