@using SparkHRMS.ViewModels;
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using System.Globalization
@{
    ViewData["Title"] = "Employee Attendance";
    var selectedDate = ViewBag.SelectedDate.ToString("yyyy-MM-dd");
    var employeeName = ViewBag.EmployeeName ?? "";
}



<div class="container mt-4">
    <ul class="breadcrumb breadcrumb-style ">
        <li class="breadcrumb-item">
            <h4 class="page-title"> Attendance</h4>
        </li>
        <li class="breadcrumb-item bcrumb-1">
            <a href="#">
                <i class="fas fa-add"></i> Employee Attendance
            </a>
        </li>

    </ul>
    <hr />
    <div class="">
        <!-- Date Filter -->
        <div class="col-md-12 mb-3">
            <form >
                <div class="row">
                    <input type="date" name="date" value="@selectedDate" class="form-control" style="width:35%;margin-right:10px;" />
                    <button type="submit" class="btn btn-info" style="width:10%;margin-right:10px;">Filter</button>
                </div>
            </form>
        </div>

        <!-- Attendance Data Table -->
        <div>
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5>Employee Attendance for @ViewBag.SelectedDate.ToString("dd MMM yyyy")</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Employee Name</th>
                                <th>Working Time</th>
                                @* <th>Check-Out Time</th> *@
                                <th>Working Hours</th>
                                <th>Check In Made System IP</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                var checkInTime = "";
                                if (record.CheckInDateTime != null)
                                {
                                    checkInTime = record.CheckInDateTime.ToString("hh:mm tt", CultureInfo.InvariantCulture);
                                }
                                var checkOutTime = "";
                                if (record.CheckOutDateTime != null)
                                {
                                    checkOutTime = record.CheckOutDateTime.ToString("hh:mm tt", CultureInfo.InvariantCulture);
                                }

                                <tr>
                                    <td>@(record.EmployeeName ?? "N/A")</td>
                                    <td class="center" style="width: 200px !important;
                                                                      max-width: 300px !important;
                                                                      min-width: 200px !important;
                                                                      word-wrap: anywhere;">
                                        <span style=" text-align: center !important;
                                                        display: block;">
                                            @checkInTime - @checkOutTime
                                        </span>
                                      
                                        <br />
                                        @record.CheckInLocation
                                    </td>
                                   @*  <td class="center" style="width: 200px !important;
                                                                      max-width: 300px !important;
                                                                      min-width: 200px !important;
                                                                      word-wrap: anywhere;">
                                        <span style=" text-align: center !important;
                                                    display: block;">@checkOutTime</span>
                                        <br />
                                        @record.CheckOutLocation
                                    </td> *@
                                    <td>@(record.WorkingHours ?? "N/A")</td>
                                    <td>@record.IP</td>
                                    <td>
                                        <a href="@Url.Action("Add", new { EmployeeId = record.EmployeeId, date = ViewBag.SelectedDate })" class="btn btn-warning btn-sm p-t-10">
                                            <i class="material-icons">create</i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
