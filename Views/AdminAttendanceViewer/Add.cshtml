@model SparkHRMS.ViewModels.EmployeeAttendanceDto

@{
    ViewData["Title"] = "Update";
}

<link href="~/app/assets/css/form.min.css" rel="stylesheet">

<link href="~/app/assets/js/bundles/flatpicker/flatpickr.min.css" rel="stylesheet">

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title"> Employee Attendance</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a>
            <i data-feather="user"></i> @Html.DisplayFor(model => model.EmployeeName) &nbsp;&nbsp;|&nbsp;&nbsp;
        </a>
        <a>
            <i data-feather="calendar"></i> @ViewBag.Date.ToString("dd-MM-yyyy")
        </a>
    </li>
</ul>
<hr />
<div class="card">
    <form>
        <div class="body">

            <div class="row clearfix" id="check_in_out_div">
                <div class="col-sm-6">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <label>Check In Time</label>
                            <input id="check_in_time" type="time" class="validate form-control" placeholder="Check In Time" asp-for="CheckInTime">
                            <span asp-validation-for="CheckInTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <div class="form-line">
                            <label>Check Out Time</label>
                            <input id="check_out_time" asp-for="CheckOutTime" type="time" class="validate form-control" placeholder="Check Out Time">
                            <span asp-validation-for="CheckOutTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row clearfix">
                
                <div class="col-sm-12">
                    <div class="form-group form-float">
                        <div class="form-line">
                            
                            <div class="radio">
                                <input type="radio" name="LeaveType" value="Permission" id="isPermission" onclick="toggleFields()">
                                <label for="isPermission">Permission</label>
                            </div>
                            <div class="radio">
                                <input type="radio" name="LeaveType" value="Leave" id="isLeave" onclick="toggleFields()">
                                <label for="isLeave">Leave</label>
                            </div>
                            <div class="radio">
                                <input type="radio" name="LeaveType" value="HalfDay" id="isHalfDayLeave" onclick="toggleFields()">
                                <label for="isHalfDayLeave">Half Day Leave</label>
                            </div>
                            <div class="radio">
                                <input type="radio" name="LeaveType" value="OnDuty" id="isOnDuty" onclick="toggleFields()">
                                <label for="isOnDuty">On Duty</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6" id="fromTimeDiv" style="display:none;">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <label>From Time</label>
                            <input id="from_time" type="time" class="validate form-control" placeholder="From Time">
                            
                        </div>
                    </div>
                </div>

                <div class="col-sm-6" id="toTimeDiv" style="display:none;">
                    <div class="form-group form-float">
                        <div class="form-line">
                            <label>To Time</label>
                            <input id="to_time" type="time" class="validate form-control" placeholder="To Time">
                           
                        </div>
                    </div>
                </div>

               
                <div class="col-sm-6" id="halfDayLeaveDiv" style="display:none;">
                    <div class="form-group">
                        <div class="form-line">
                            <label>Half Day Leave</label>
                            <div class="radio">
                                <input type="radio" name="HalfDay" value="FirstHalf" id="halfDayFirstHalf">
                                <label for="halfDayFirstHalf">First Half</label>
                            </div>
                            <div class="radio">
                                <input type="radio" name="HalfDay" value="SecondHalf" id="halfDaySecondHalf">
                                <label for="halfDaySecondHalf">Second Half</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            

            <div class="col-lg-12 p-t-20 text-center">
                <button type="button" class="btn btn-primary waves-effect m-r-15" fdprocessedid="y228pc" onclick="addEmployeeCheckInDetais();">Submit</button>
                <a type="button" asp-action="Index" class="btn btn-danger waves-effect" fdprocessedid="3tfajj">Back</a>
            </div>


        </div>
    </form>
</div>

<script>
    function addEmployeeCheckInDetais() {

        var checkInDateTimeString = '@ViewBag.Date.ToString("dd-MM-yyyy")' + " " + $('#check_in_time').val();
        var checkOutDateTimeString = '@ViewBag.Date.ToString("dd-MM-yyyy")' + " " + $('#check_out_time').val();

        var checkInDate = moment(checkInDateTimeString, "DD-MM-YYYY HH:mm").toDate();
        var checkOutDate = moment(checkOutDateTimeString, "DD-MM-YYYY HH:mm").toDate();

        // if (checkOutDate < checkInDate) {
        //     Swal.fire({
        //         icon: 'warning',
        //         title: 'Warning',
        //         text: 'Check Out time must be greater than check in time.'
        //     });
        //     return false;
        // }
        var formattedCheckInDate = moment(checkInDate).format("YYYY-MM-DD HH:mm:ss");
        var formattedCheckOutDate = moment(checkOutDate).format("YYYY-MM-DD HH:mm:ss");

        let obj = {
            EmployeeId: @ViewBag.EmployeeId,
            CheckInTime: formattedCheckInDate,
            CheckOutTime: formattedCheckOutDate
        };

        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to update the data?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, update it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: "/AdminAttendanceViewer/Add",
                    data: obj,
                    type: 'POST',
                    success: function (response) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Updated Successful',
                            text: 'Data Updated Successfully!'
                        }).then(() => {
                            window.history.back();
                        });
                    },
                    error: function (xhr) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Added Failed',
                            text: 'Failed to Add: ' + xhr.responseText
                        });
                    }
                });
            }
        });


    }

    function toggleFields() {
        
        document.getElementById("check_in_out_div").style.display = "";
        document.getElementById("fromTimeDiv").style.display = "none";
        document.getElementById("toTimeDiv").style.display = "none";
        document.getElementById("halfDayLeaveDiv").style.display = "none";

        if (document.getElementById("isPermission").checked) {
            document.getElementById("fromTimeDiv").style.display = "block";  
            document.getElementById("toTimeDiv").style.display = "block"; 
        } else if (document.getElementById("isLeave").checked) {
            document.getElementById("check_in_out_div").style.display = "none";  
            document.getElementById("fromTimeDiv").style.display = "none";  
            document.getElementById("toTimeDiv").style.display = "none"; 
        } else if (document.getElementById("isHalfDayLeave").checked) {
            document.getElementById("halfDayLeaveDiv").style.display = "block"; 
            document.getElementById("fromTimeDiv").style.display = "none";  
            document.getElementById("toTimeDiv").style.display = "none"; 
        } else if (document.getElementById("isOnDuty").checked) {
            document.getElementById("fromTimeDiv").style.display = "block"; 
            document.getElementById("toTimeDiv").style.display = "block"; 
        }
    }
</script>

<!-- Include jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<!-- Include SweetAlert from CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
<script src="~/app/assets/js/bundles/dropzone.js"></script>
<script src="~/app/assets/js/bundles/flatpicker/flatpicker.min.js"></script>

<script src="~/app/assets/js/pages/forms/selectitem-data.js"></script>
<script src="~/app/assets/js/pages/forms/flatpicker-data.js"></script>
<script src="~/app/assets/js/pages/forms/dropzone-data.js"></script>
