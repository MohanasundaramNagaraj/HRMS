@using Microsoft.AspNetCore.Identity
@using SparkHRMS.Data.Entities
@using SparkHRMS.Utilities
@using SparkHRMS.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Employee Monthly Summary";
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
}

<link href="~/app/assets/css/bundles/dataTables.bootstrap5.min.css" rel="stylesheet">

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
<script>
    function downloadExcel() {
        var table = document.querySelector("table");

        // Clone to avoid affecting UI
        var clone = table.cloneNode(true);

        var wb = XLSX.utils.table_to_book(clone, { sheet: "Summary" });
        XLSX.writeFile(wb, "Summary.xlsx");
    }


    function downloadPDF() {
        const { jsPDF } = window.jspdf;
        var doc = new jsPDF('l', 'pt', 'a4');


        // Clone table & remove last column
        var table = document.querySelector("table");
        var clone = table.cloneNode(true);


        doc.autoTable({
            html: clone,
            startY: 60,
            theme: 'grid',
            styles: { fontSize: 8 },
            headStyles: { fillColor: [52, 73, 94] }
        });

        doc.save("Summary.pdf");
    }
</script>

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title">Attendance</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            Monthly Summary
        </a>
    </li>
</ul>

<div class="row clearfix">
    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
    {
        <div class="col-md-12 mb-3">
            <div>
                <div class="">
                    <select id="monthSelector" style="width:35%;margin-right:10px;display:inline-block">
                        <option value="">Select Month</option>
                        @for (int month = 1; month <= 12; month++)
                        {
                            if (month == ViewBag.SelectedMonth)
                            {
                                <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                            else
                            {
                                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                        }
                    </select>

                    <button onclick="getData()" class="btn btn-info">
                        Filter
                    </button>

                    <button class="btn btn-success" onclick="downloadExcel()" style="width:10%;margin-right:10px;float:right">Download Excel</button>
                    <button class="btn btn-danger" onclick="downloadPDF()" style="width:10%;margin-right:10px;float:right">Download PDF</button>

                </div>
            </div>
        </div>
    }

    <div class="col-lg-12 col-md-12">
        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="project" aria-expanded="true">
                <div class="row clearfix">

                    <div class="col-lg-12 col-md-12 col-sm-12">
                        <div class=" project_widget">

                            <div class="body">
                                <div class="row">
                                    <div class="table-responsive">
                                        <table id="dataTable" class="display nowrap table table-hover" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th class="center"> </th>
                                                    <th class="center" colspan="3"> Employee Details </th>
                                                    <th class="center" colspan="4"> Working Day Detail </th>
                                                    <th class="center" colspan="4"> Leave Detail </th>
                                                    <th class="center" colspan="3"> Attendance Detail </th>
                                                </tr>
                                                <tr>
                                                    <th class="center"> # </th>

                                                    <th class="center"> Employee Code </th>
                                                    <th class="center"> Employee Name </th>
                                                    <th class="center"> Designation </th>

                                                    <th class="center"> Days in Month </th>
                                                    <th class="center"> Holiday  </th>
                                                    <th class="center"> Weekend  </th>
                                                    <th class="center"> Working Days </th>


                                                    <th class="center"> CL Taken </th>
                                                    <th class="center"> EL Taken </th>
                                                    <th class="center"> LOP </th>
                                                    <th class="center"> Total Leave Taken </th>


                                                    <th class="center"> Present  </th>
                                                    <th class="center"> Permission  </th>
                                                    <th class="center"> Pending Check out  </th>
                                                </tr>
                                               
                                            </thead>
                                            <tbody>
                                                @{
                                                    int count = 0;
                                                }
                                                @foreach (var record in Model)
                                                {
                                                    int rowspan = 1;
                                                    count = count + 1;
                                                    <tr class="odd gradeX">
                                                        <td rowspan="@rowspan">@count</td>

                                                        <td rowspan="@rowspan">@record.EmployeeDetails.EmpCode</td>
                                                        <td rowspan="@rowspan">@record.EmployeeDetails.Name</td>
                                                        <td rowspan="@rowspan">@record.EmployeeDetails.Designation</td>

                                                        <td rowspan="@rowspan">@record.EmployeeAttendanceStatusCounts.DaysInMonth</td>
                                                        <td rowspan="@rowspan">@record.EmployeeAttendanceStatusCounts.EmployeeHolidayCountOnMonth</td>
                                                        <td rowspan="@rowspan">@record.EmployeeAttendanceStatusCounts.EmployeeWeekendCountOnMonth</td>
                                                        <td rowspan="@rowspan">@record.EmployeeAttendanceStatusCounts.TotalWorkingDays</td>

                                                        @* @if (record.EmployeeAttendanceStatusCounts.LeaveAllocations.Count > 0)
                                                        {
                                                            <td colspan="4">
                                                                <table class="table table-sm table-bordered mb-0">

                                                                    @foreach (var r in record.EmployeeAttendanceStatusCounts.LeaveAllocations)
                                                                    {
                                                                        <tr>
                                                                            <td>@r.Code</td>
                                                                            <td>@r.Name</td>
                                                                            <td>@r.AllocatedDays</td>
                                                                            <td>@r.RemainingDays</td>
                                                                        </tr>
                                                                    }
                                                                </table>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td colspan="4"></td>
                                                        } *@

                                                        <td></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td>@record.EmployeeAttendanceStatusCounts.EmployeeAbsentCountOnMonth</td>

                                                        <td rowspan="@rowspan">
                                                            @(record.EmployeeAttendanceStatusCounts.EmployeePresentCountOnMonth + (record.EmployeeAttendanceStatusCounts.EmployeeHalfDayCountOnMonth * 0.5))
                                                        </td>
                                                        <td rowspan="@rowspan">@record.EmployeeAttendanceStatusCounts.EmployeePermissionNeededCountOnMonth</td>
                                                        <td rowspan="@rowspan">@record.EmployeeAttendanceStatusCounts.EmployeePendingCheckOutNeededCountOnMonth</td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


@section Scripts {


    <script>
        function getData(obj) {
            var frm = $("<form hidden action='/AdminAttendanceViewer/EmployeeMonthlySummary' method='get'> </form>");
            $(frm).append("<input type='hidden' name='Month' value=" + parseInt($("#monthSelector").val()) + " id='Month'>");
            $(document).find("body").append(frm);
            setTimeout(function () {
                $(frm).submit();
            }, 100);

        }

        $('#dataTable').DataTable();
    </script>
}