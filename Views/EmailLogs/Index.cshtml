@model IEnumerable<SparkHRMS.Data.Entities.EmailLogs>

@{
    ViewData["Title"] = "Index";
}
<style>
    .modal {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 100000; /* Sit on top */
        left: 0;
        top: 0;
        width: 100%; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0, 0, 0); /* Fallback color */
        background-color: rgba(0, 0, 0, 0.4); /* Black w/ opacity */
    }

    .modal-content {
        background-color: #fefefe;
        padding: 20px;
        border: 1px solid #888;
        margin: 5% 25%;
        width: 50%;
    }

    .close-button {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

        .close-button:hover,
        .close-button:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

</style>
<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Email</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> Logs
                </a>
            </li>
        </ul>
    </div>
</div>

<table class="table table-bordered mt-3 display" style="width:100%" id="emailLogs">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Recipient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Cc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subject)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Body)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsSuccessful)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ErrorMessage)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="max-width:100px;">
                    <p style="    word-wrap: break-word;">@Html.DisplayFor(modelItem => item.Recipient)</p>
                </td>
                <td style="max-width:100px;">
                    <p style=" word-wrap: break-word;">@Html.DisplayFor(modelItem => item.Cc)</p>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Subject)
                </td>
                <td style="width: 200px !important;
                  max-width: 300px !important;
                  min-width: 200px !important;
                  text-align: inherit;
                  word-wrap: anywhere;">
                    <span class="truncated-text">
                        @if (item.Body.Length > 200)
                        {
                            <span>@item.Body.Substring(0, 200) + "..."</span>
                            <button class="show-more" id="htmlBody" data-fulltext="@item.Body">Show More</button>
                        }
                        else
                        {
                            @Html.Raw(item.Body)
                        }
                    </span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SentDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsSuccessful)
                </td>
                <td style="width: 200px !important;
                  max-width: 300px !important;
                  min-width: 200px !important;
                  text-align: inherit;
                  word-wrap: anywhere;">
                    <span class="truncated-text">
                        @if (item.ErrorMessage.Length > 200)
                        {
                            <span>@item.ErrorMessage.Substring(0, 200) + "..."</span>
                            <button class="show-more" data-fulltext="@Html.Raw(item.ErrorMessage)">Show More</button>
                        }
                        else
                        {
                            @Html.Raw(item.ErrorMessage)
                        }
                    </span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> 
                </td>
            </tr>
        }
    </tbody>
</table>

<div id="fullTextModal" class="modal">
    <div class="modal-content">
        <span class="close-button">&times;</span>
        <p id="full-text-content"></p>
    </div>
</div>


<script>
    // Get modal element
    var modal = document.getElementById("fullTextModal");
    var closeButton = document.getElementsByClassName("close-button")[0];

    // Show modal with full text
    document.querySelectorAll(".show-more").forEach(button => {
        button.addEventListener("click", function () {
            var fullText = this.getAttribute("data-fulltext");
            var isBodyContent = this.getAttribute("id");
            if (isBodyContent == 'htmlBody'){
                document.getElementById("full-text-content").innerHTML = fullText;
            }else{
                document.getElementById("full-text-content").innerText = fullText;

            }
            modal.style.display = "block";
        });
    });

    // Close modal when clicking on the close button
    closeButton.onclick = function () {
        modal.style.display = "none";
    }

    // Close modal when clicking anywhere outside of the modal
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    $('#emailLogs').DataTable();
</script>