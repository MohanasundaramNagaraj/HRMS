@inject SparkHRMS.Utilities.Utility UtilityService
@using SparkHRMS.Data.Entities

@model IEnumerable<LeaveAllocation>

@{
    ViewData["Title"] = "List";
}

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Leave Allocation & Balance </h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>
        @if (ViewBag.IsUserAdmin)
        {
            <a class="btn btn-tbl-add btn-success" href="@Url.Action("Create")" style="float:right;">
                <i class="material-icons">add</i>
            </a>
        }
    </div>
</div>

<table class="table table-bordered mt-3 dataTable">
    <thead>
        <tr>
            <th rowspan="2">Employee</th>
            <th rowspan="2">Year</th>

            <th colspan="3" style="text-align:center;">Allocated</th>
            <th colspan="3" style="text-align:center;">Total Used</th>
            <th colspan="3" style="text-align:center;">Leave Balance</th>

            @if (ViewBag.IsUserAdmin)
            {
                <th rowspan="2">Actions</th>
            }
        </tr>

        <tr>
            <!-- Allocated -->
            <th style="text-align:center;">CL</th>
            <th style="text-align:center;">EL</th>
            <th style="text-align:center;">Total</th>

            <!-- Total Used -->
            <th style="text-align:center;">CL</th>
            <th style="text-align:center;">EL</th>
            <th style="text-align:center;">Total</th>

            <!-- Leave Balance -->
            <th style="text-align:center;">CL</th>
            <th style="text-align:center;">EL</th>
            <th style="text-align:center;">Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var cl = item.LeaveDetails?.FirstOrDefault(x => x.LeaveTypeId == 1);
            var el = item.LeaveDetails?.FirstOrDefault(x => x.LeaveTypeId == 2);

            decimal clAllocated = cl?.AllocatedDays ?? 0;
            decimal elAllocated = el?.AllocatedDays ?? 0;

            decimal clUsed = cl?.UsedDays ?? 0;
            decimal elUsed = el?.UsedDays ?? 0;

            decimal clBalance = cl?.RemainingDays ?? 0;
            decimal elBalance = el?.RemainingDays ?? 0;

            <tr>
                <!-- Employee -->
                <td style="text-align:left;">
                    @UtilityService.GetEmployeeCodeById(item.EmployeeId) -
                    @UtilityService.GetEmployeeNameById(item.EmployeeId)
                </td>

                <!-- Year -->
                <td style="text-align:right;">
                    @UtilityService.GetYearById(item.YearId).Year
                </td>

                <!-- Allocated -->
                <td style="text-align:right;">@clAllocated</td>
                <td style="text-align:right;">@elAllocated</td>
                <td style="text-align:right;">@(clAllocated + elAllocated)</td>

                <!-- Used -->
                <td style="text-align:right;">@clUsed</td>
                <td style="text-align:right;">@elUsed</td>
                <td style="text-align:right;">@(clUsed + elUsed)</td>

                <!-- Balance -->
                <td style="text-align:right;">@(clBalance = clAllocated - clUsed)</td>
                <td style="text-align:right;">@(elBalance =elAllocated - elUsed)</td>
                <td style="text-align:right;">@(clBalance + elBalance)</td>

                @if (ViewBag.IsUserAdmin)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <button onclick="confirmDelete('@item.Id')" class="btn btn-danger btn-sm">Delete</button>
                    </td>
                }
            </tr>
        }
    </tbody>

</table>


@section Scripts {

    <script>
        $(document).ready(function () {
            $('.table').DataTable();
        });
        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/LeaveAllocation/Delete/' + id;
                }
            })
        }
    </script>
}

