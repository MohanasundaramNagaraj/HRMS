@using SparkHRMS.Data.Masters

@model LeaveReasons

@{
    ViewData["Title"] = "Delete Leave Reason";
}

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title"> Leave Reasons</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            <i class="fas fa-add"></i> Delete
        </a>
    </li>
</ul>
<hr />

<h4>Are you sure you want to delete this?</h4>

<div class="mb-3">
    <strong>Name:</strong> @Model.LeaveReasonName
</div>
<div class="mb-3">
    <strong>Description:</strong> @Model.Description
</div>

<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="LeaveReasonId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
 