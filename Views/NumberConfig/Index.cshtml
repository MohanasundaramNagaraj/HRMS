@using SparkHRMS.Data.Setting
@model List<SET_NumberConfig>

<div class="container mt-4 ">
    <div class="d-flex justify-content-between  mb-3">
        <h2 class="fw-bold">Number Configurations</h2>
        <a asp-action="Create" class="btn btn-success px-4">+</a>
    </div>

    <div class="card shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Document Type</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Prefix</th>
                            <th>Suffix</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DocumentType</td>
                                <td>@item.StartNumber</td>
                                <td>@item.EndNumber</td>
                                <td>@item.Prefix</td>
                                <td>@item.Suffix</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.NConfigID" class="btn btn-sm btn-primary">Edit</a>
                                   @*      <a asp-action="Delete" asp-route-id="@item.NConfigID" class="btn btn-sm btn-danger">Delete</a>
                                        <a asp-action="Details" asp-route-id="@item.NConfigID" class="btn btn-sm btn-secondary">Details</a> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
