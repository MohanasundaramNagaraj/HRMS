@using SparkHRMS.Data.Setting
@model List<SET_NumberConfig>

@{
    
    ViewData["Title"] = "Number Configuration List";
}
<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Number Configuration</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Create")"
           style="float:right;">
            <i class="material-icons">add</i>
        </a>
    </div>
</div>
<hr/>
<div>
    <div class="card shadow-sm rounded-4">
        <div class="card-body p-5">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Document Type</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Prefix</th>
                            <th>Suffix</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DocumentType</td>
                                <td>@item.StartNumber</td>
                                <td>@item.EndNumber</td>
                                <td>@item.Prefix</td>
                                <td>@item.Suffix</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.NConfigID" class="btn btn-sm btn-primary">Edit</a>
                                   @*      <a asp-action="Delete" asp-route-id="@item.NConfigID" class="btn btn-sm btn-danger">Delete</a>
                                        <a asp-action="Details" asp-route-id="@item.NConfigID" class="btn btn-sm btn-secondary">Details</a> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script>
    $('.table').DataTable({
        order: []
    });
</script>