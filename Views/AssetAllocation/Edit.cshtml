@model SparkHRMS.Data.Setting.AssetAllocation
@{
    ViewData["Title"] = "Edit Allocation";
}

<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title"> Assets Allocation</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            <i class="fas fa-add"></i> Edit
        </a>
    </li>
</ul>
<hr />
<div class="card p-3">
    <form asp-action="Edit">
        <input type="hidden" asp-for="AllocationId" />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Asset</label>
                    <select asp-for="AssetId" asp-items="ViewBag.AssetId" class="form-control"></select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Employee</label>
                    <select asp-for="EmployeeId" asp-items="ViewBag.EmployeeId" class="form-control"></select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Allocation Date</label>
                    <input asp-for="AllocationDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>Return Date</label>
                    <input asp-for="ReturnDate" type="date" class="form-control" />
                </div>
            </div>
            <div class="col-md-6">

                <div class="form-group">
                    <label>Returned</label>
                    <input asp-for="IsReturned" type="checkbox" />
                </div>
            </div>

        </div>

        <div class="col-lg-12 p-t-20 text-center">
            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary waves-effect m-r-15">
                <a type="button" class="btn btn-danger waves-effect" href="@Url.Action("Index")">Cancel</a>
            </div>
        </div>
    </form>
</div>

