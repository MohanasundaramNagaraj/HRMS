@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
	ViewData["Title"] = "Create Project";
}

<ul class="breadcrumb breadcrumb-style ">
	<li class="breadcrumb-item">
		<h4 class="page-title"> Project</h4>
	</li>
	<li class="breadcrumb-item bcrumb-1">
		<a href="#">
			<i class="fas fa-add"></i> Create Project
		</a>
	</li>
</ul>
<hr/>


<div class="row">
	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
		<div class="card">
			<div class="header">
				<h2>
					<strong>Add</strong> Project
				</h2>
				<ul class="header-dropdown m-r--5">
					<li class="dropdown">
						<a href="#" onclick="return false;" class="dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
							<i class="material-icons">more_vert</i>
						</a>
						<ul class="dropdown-menu float-end">
							<li>
								<a href="#" onclick="return false;">Action</a>
							</li>

						</ul>
					</li>
				</ul>
			</div>
			<div class="body">
				<form id="create-project-form" method="Post" action="/project/createproject">
					<div class="row clearfix">
						<div class="col-sm-6">
							<div class="form-group">
								<div class="form-line">
									<input id="project_name" error-message-element="project_name_error" name="Name" type="text" class="form-control" placeholder="Project Name">
									<span id="project_name_error" class="text-danger" style="display:none">project name required</span>
								</div>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="justify-content-center align-item-center mt-3">
								<select id="project_client_select" error-message-element="project_client_select_error" name="ProjectClientName" class="h-20" style="width:100%;margin-right:10px;margin-top:2px; display:inline-block">
									<option value="">Select Client Name</option>
								</select>
								<span id="project_client_select_error" class="text-danger" style="display:none">client name required</span>
							</div>
						</div>
					</div>
					<div class="row clearfix">
						<div class="col-sm-12">
							<div class="form-group">
								<div class="form-line">
									<textarea id="project_description" error-message-element="project_description_error" rows="4" name="Description" class="form-control no-resize" placeholder="Description"></textarea>
									<span id="project_description_error" class="text-danger" style="display:none">project description required</span>
								</div>
							</div>
						</div>
					</div>

					<div class="row clearfix">
						<div class="col-sm-6">
							<div class="form-group focused">
								<input type="datetime-local" class="form-control" placeholder="Planned Start Date" error-message-element="project_planned_start_date_error" name="PlannedStartDate" id="project_planned_start_date">
								<span id="project_planned_start_date_error" class="text-danger" style="display:none"></span>
							</div>
						</div>
						<div class="col-sm-6">
							<div class="form-group focused">
								<input type="datetime-local" class="form-control" placeholder="Planned End Date" error-message-element="project_planned_end_date_error" name="PlannedEndDate" id="project_planned_end_date">
								<span id="project_planned_end_date_error" class="text-danger" style="display:none"></span>
							</div>
						</div>
					</div>

					<div class="col-lg-12 p-t-20 text-end">
						<button type="submit" class="btn btn-primary waves-effect m-r-15">Create New Project</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>


<script src="~/js/project/create-project.js?v=@Configuration["AppSettings:Version"]"></script>


