@using SparkHRMS.Data.Entities

@using SparkHRMS.Utilities

@model LeaveRequest
@{
    var isReadOnly = ViewData["IsReadOnly"] as bool? ?? false;
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Leave Request";
}
<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Leave Request</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> Create
                </a>
            </li>
        </ul>
    </div>
</div>

<hr />

<form asp-action="Create">
    <div class="card shadow p-4">
       
        <div class="row">
            <div class="col-md-3 mb-3">

                <label asp-for="EmployeeId" class="form-label"></label>
                @* <input asp-for="EmployeeId" class="form-control" readonly="@isReadOnly" hidden /> *@

                <select style="margin-top: 10px;" asp-for="EmployeeId" class="form-control" readonly="@isReadOnly" class="form-select" id="empSelector" required>
                    @{
                        var employeeList = ViewBag.EmployeeList;
                    }
                    <option value="">Select Employee</option>
                    @foreach (var record in employeeList)
                    {
                        if (Model.EmployeeId == record.EmployeeId)
                        {
                            <option value="@record.EmployeeId" selected>@record.EmployeeCode - @record.Name</option>
                        }
                        else
                        {
                            <option value="@record.EmployeeId">@record.EmployeeCode - @record.Name</option>
                        }

                    }
                </select>
            </div>

            <div class="col-md-3 mb-3">
                <div class="mb-3">
                    <label asp-for="RequestNumber" class="form-label"></label>
                    <input asp-for="RequestNumber" class="form-control" readonly="true" />
                </div>
            </div>
            <div class="col-md-3 mb-3">
                <div class="mb-3">
                    <label asp-for="RequestedDate" class="form-label"></label>
                    <input asp-for="RequestedDate" class="form-control" readonly="true" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
            </div>
            
            <div class="col-md-3 mb-3">
                <div class="mb-3" id="isactivediv">
                    <label asp-for="Status" class="form-label"></label>
                    <input asp-for="Status" class="form-control" value="@Model.Status" readonly="true" />
                </div>
            </div>

        </div>

      
        @{
            var today = DateTime.Today;
            var firstDayOfThisMonth = new DateTime(today.Year, today.Month, 1);
            var lastDayOfNextMonth = new DateTime(today.Year, today.Month, 1).AddMonths(2).AddDays(-1);
        }

        <div class="row mb-3">
            <div class="col-md-4 mb-3 ">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control"
                       min="@firstDayOfThisMonth:yyyy-MM-dd" max="@lastDayOfNextMonth:yyyy-MM-dd"
                       readonly="@isReadOnly" id="StartDate" />
                <div class="form-check mt-1">
                    <input asp-for="IsStartDateHalfDay" class="form-check-input" disabled="@isReadOnly" id="IsStartDateHalfDay" />
                    <label class="form-check-label" asp-for="IsStartDateHalfDay">Half Day</label>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Number of Days</label>
                <input type="number" class="form-control" id="LeaveDayCount" min="0.5" step="0.5" />
            </div>
       
            <div class="col-md-4 mb-3">
                <label asp-for="EndDate" class="form-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" readonly id="EndDate" />
                <div class="form-check mt-1">
                    <input asp-for="IsEndDateHalfDay" class="form-check-input" disabled="@isReadOnly" id="IsEndDateHalfDay" />
                    <label class="form-check-label" asp-for="IsEndDateHalfDay">Half Day</label>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6 mb-3">
                <label asp-for="LeaveTypeId" class="form-label"></label>
                <select asp-for="LeaveTypeId" class="form-control" asp-items="ViewBag.LeaveTypes" disabled="@isReadOnly"></select>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="LeaveReasonId" class="form-label"></label>
                <select asp-for="LeaveReasonId" class="form-control" asp-items="ViewBag.LeaveReasons" id="leaveReasonSelect" disabled="@isReadOnly"></select>
            </div>
        </div>

        <div class="mb-3" id="commentsDiv_">
            <label asp-for="Comments" class="form-label"></label>
            <input asp-for="Comments" class="form-control" value="Leave Request" rows="3" readonly="@isReadOnly"/>
        </div>

        <div class="col-lg-12 p-t-20 text-center">
            <div class="form-group">
                @if (!isReadOnly)
                {
                    <input type="submit" value="Update" class="btn btn-primary waves-effect m-r-15">
                }
                <a type="button" class="btn btn-danger waves-effect" href="@Url.Action("Index")">Cancel</a>
            </div>
        </div>
    </div>
</form>
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script>
    $(document).ready(function () {

        function toggleComments() {
            var selectedText = $("#leaveReasonSelect option:selected").text().toLowerCase();
            if (selectedText === "others") {
                $("#commentsDiv").show();
            } else {
                $("#commentsDiv").hide();
                $("#Comments").val(""); // Optional: clear comments when hidden
            }
        }

        // Initial check on page load
        toggleComments();

        // Bind change event
        $("#leaveReasonSelect").change(function () {
            toggleComments();
        });

        $("#StartDate, #EndDate, #IsStartDateHalfDay, #IsEndDateHalfDay").on("change", function () {
            calculateEndDate();
        });

        $("#LeaveDayCount").on("input", function () {
            calculateEndDate();
        });

        
    });

   function calculateEndDate() {
        const startDateStr = $("#StartDate").val();
        const daysInput = parseFloat($("#LeaveDayCount").val());

        if (startDateStr && !isNaN(daysInput) && daysInput > 0) {
            const startDate = new Date(startDateStr);
            let fullDays = Math.floor(daysInput);
            let isHalfDay = daysInput % 1 !== 0;

            const endDate = new Date(startDate);
            endDate.setDate(startDate.getDate() + fullDays - 1);

            // If half day at end, add one more day
            if (isHalfDay) {
                endDate.setDate(endDate.getDate() + 1);
                $("#IsEndDateHalfDay").prop("checked", true);
            } else {
                $("#IsEndDateHalfDay").prop("checked", false);
            }

            // Format as yyyy-MM-dd
            const formatted = endDate.toISOString().split('T')[0];
            $("#EndDate").val(formatted);
        }
    }

   
</script>
