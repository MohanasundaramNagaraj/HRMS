@using SparkHRMS.Data.Entities
@using Microsoft.AspNetCore.Html
@using SparkHRMS.Utilities

@model LeaveRequest
@{
    var isReadOnly = ViewBag.FMode != "ADD";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Leave Request - " + ViewBag.FMode;
}

<link href="~/app/assets/js/bundles/flatpicker/flatpickr.min.css" rel="stylesheet">

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Leave Request</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> @ViewBag.FMode
                </a>
            </li>
        </ul>
    </div>
</div>
<div id="leaveValidationMessage" class="text-danger mt-2" style="display:none;"></div>

<hr />

@if (ViewBag.FMode == "ADD")
{
    <form asp-action="@(ViewBag.FMode == "ADD" ? "Create" : null)" id="leaveRequestForm">
        @await Html.PartialAsync("LeaveRequestForm", Model)
    </form>

}
else
{
    <div>
        @await Html.PartialAsync("LeaveRequestForm", Model)
    </div>

}

<script src="~/app/assets/js/bundles/flatpicker/flatpicker.min.js"></script>

<script src="~/app/assets/js/pages/forms/selectitem-data.js"></script>
<script src="~/app/assets/js/pages/forms/flatpicker-data.js"></script>
<script>

    let leaveRequestId = @Model.Id;
    let fmode = '@ViewBag.FMode';
    $(document).ready(function () {
        function toggleComments() { 
            var selectedText = $("#leaveReasonSelect option:selected").text().toLowerCase();
            if (selectedText === "others") {
                $("#commentsDiv").show();
            } else {
                $("#commentsDiv").hide();
                $("#Comments").val(""); // Optional: clear comments when hidden
            }
        }

        // Initial check on page load
        toggleComments();

        // Bind change event
        $("#leaveReasonSelect").change(function () {
            toggleComments();
        });

        $("#date1, #EndDate, #IsStartDateHalfDay, #IsEndDateHalfDay").on("change", function () {
            calculateEndDate();
        });

        $("#LeaveDayCount").on("input", function () {
            calculateEndDate();
        });

        var employeeId = $('#empSelector').val();
        if (employeeId) {
            fetchLeaveTypes(employeeId);
        }

        $('#empSelector').change(function () {
            var empId = $(this).val();
            fetchLeaveTypes(empId);
        });

        function fetchLeaveTypes(empId) {

            $.get('/LeaveRequest/GetLeaveTypeDetails?employeeId=' + empId + '&LeaveRequestId=' + leaveRequestId, function (data) {

                var tbody = $('#leaveTypeBody');
                tbody.empty();
                data.forEach(function (item, index) {
                    item.BalanceDays = item.AllocatedDays - item.UsedDays;
                    let uniqueid = generateUUIDv4();

                    tbody.append(`
                                                        <tr uid="${uniqueid}" class="leaveTypeRow">
                                                        <td> 
                                                                ${item.LeaveTypeName}
                                                                <input type="hidden" name="LeaveRequestDetails[${index}].LeaveTypeId" value="${item.LeaveTypeId}" />
                                                        </td>
                                                        <td>
                                                                <input type="number" class="form-control text-end" name="LeaveRequestDetails[${index}].AllocatedDays" value="${item.AllocatedDays}" readonly />
                                                        </td>
                                                        <td>
                                                                <input type="number" class="form-control text-end" name="LeaveRequestDetails[${index}].UsedDays" value="${item.UsedDays}" readonly />
                                                        </td>
                                                        <td>
                                                                <input type="number" class="form-control text-end" name="LeaveRequestDetails[${index}].BalanceDays" value="${item.BalanceDays}" readonly />
                                                        </td>
                                                        <td>
                                                                       <input type="number" 
                                                                       class="form-control text-center requiredDays" 
                                                                       name="LeaveRequestDetails[${index}].RequiredDays" 
                                                                       value="${item.RequiredDays}" step="0.5" 
                                                                       min="0" max="${item.BalanceDays}" 
                                                                       oninput="if (this.value < 0.5) this.value = '';"/>
                                                        </td>
                                                    </tr>
                                                `);
                });

                if (data.length == 0) {
                    tbody.append(`
                                                        <tr>
                                                           <td colspan="5">
                                                                No Leave Allocated
                                                           </td>
                                                        </tr>
                                                    `);
                }
                if (fmode != 'ADD' && fmode != 'Approve') {
                    $('.requiredDays').prop('disabled',true);
                }
            });
        }
    });

    $(document).on('input', 'input[name^="LeaveRequestDetails"][name$=".RequiredDays"]', function () {
        let isValid = true;
        let totalRequiredDays = 0;

        $('#leaveTypeBody tr').each(function () {
            const $row = $(this);
            const requiredInput = $row.find('input[name$=".RequiredDays"]');
            const balanceInput = $row.find('input[name$=".BalanceDays"]');

            const required = parseFloat(requiredInput.val()) || 0;
            const balance = parseFloat(balanceInput.val()) || 0;


            if (required > balance) {
                requiredInput.addClass('is-invalid');
                $('#leaveValidationMessage').text('Required Days must be less than balance days.');
                isValid = false;
            } else {
                requiredInput.removeClass('is-invalid');
            }

            totalRequiredDays += required;
        });

        const leaveDayCount = parseFloat($('#LeaveDayCount').val()) || 0;


        if (totalRequiredDays !== leaveDayCount) {
            $('#LeaveDayCount').addClass('is-invalid');
            $('#leaveValidationMessage').text('Total Leave Days must be equal with total required days.');
            isValid = false;
        } else {
            $('#LeaveDayCount').removeClass('is-invalid');
        }

        if (!isValid) {
            $('#leaveValidationMessage').show();
            $('#requestLeaveBtn').addClass('disabled').css('pointer-events', 'none').css('opacity', '0.6');

        } else {
            $('#leaveValidationMessage').hide();
            $('#requestLeaveBtn').removeClass('disabled').css('pointer-events', '').css('opacity', '');

        }
    });


    function calculateEndDate() {
        const inputDate = $("#StartDate").val();

       //  const inputDate = $("#date1").val();
        // const [day, month, year] = inputDate.split('-');
        // const startDateStr = `${year}-${month}-${day}`;

        const startDateStr = inputDate;
        const daysInput = parseFloat($("#LeaveDayCount").val());

        if (startDateStr && !isNaN(daysInput) && daysInput > 0) {
            $.ajax({
                url: '/LeaveRequest/GetNonWorkingDays',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ startDate: startDateStr }),
                success: function (response) {
                    const nonWorkingDates = response.holidays; // array of 'yyyy-MM-dd'
                    const weekOffs = response.weekOffDays; // array of integers: 0 = Sunday, 1 = Monday, ..., 6 = Saturday

                    const startDate = new Date(startDateStr);
                    let fullDays = Math.floor(daysInput);
                    const isHalfDay = daysInput % 1 !== 0;

                    let countedDays = 0;
                    let currentDate = new Date(startDate);

                    while (countedDays < fullDays) {
                        const isoDate = currentDate.toISOString().split('T')[0];
                        const isWeekOff = weekOffs.includes(currentDate.getDay());
                        const isHoliday = nonWorkingDates.includes(isoDate);

                        if (!isWeekOff && !isHoliday) {
                            countedDays++;
                        }
                        debugger;
                        if (countedDays < fullDays) {
                            currentDate.setDate(currentDate.getDate() + 1);
                        }
                    }

                    // Handle half day
                    if (isHalfDay) {
                        while (true) {
                            if(daysInput > 1){
                                currentDate.setDate(currentDate.getDate() + 1);
                            }
                            
                            const isoDate = currentDate.toISOString().split('T')[0];
                            const isWeekOff = weekOffs.includes(currentDate.getDay());
                            const isHoliday = nonWorkingDates.includes(isoDate);

                            if (!isWeekOff && !isHoliday) {
                                $("#IsEndDateHalfDay").prop("checked", true);
                                break;
                            }
                        }
                    } else {
                        $("#IsEndDateHalfDay").prop("checked", false);
                    }

                    const formatted = currentDate.toISOString().split('T')[0];
                    $("#EndDate").val(formatted);
                },
                error: function () {
                    alert("Unable to fetch holiday data from server.");
                }
            });
        }
    }

    function calculateRequiredDaysTotal() {
        let total = 0;
        $('.requiredDays').each(function () {
            let val = parseFloat($(this).val());
            if (!isNaN(val)) {
                total += val;
            }
        });
        return total;
    }

    function saveLeaveRequest() {
       
        if ($('#empSelector').val() == '') {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid',
                text: 'Please Select Employee'
            });

            return false;
        }

        let leaveDaysCount = parseFloat($('#LeaveDayCount').val());
        if (leaveDaysCount == 0 || leaveDaysCount == undefined) {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid',
                text: 'Number of days should not be empty or zero'
            });

            return false;
        }
        
      

        if ($('.leaveTypeRow').length == 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid',
                text: 'Please Allocate or split your leaves'
            });

            return false;
        }
        let _calculateRequiredDaysTotal = calculateRequiredDaysTotal();
        if (_calculateRequiredDaysTotal != leaveDaysCount){
            Swal.fire({
                icon: 'warning',
                title: 'Invalid',
                text: 'Required leave days should be equal to allocated leave days.'
            });

            return false;
        }
        if ($('#Comments').val() == '') {
            Swal.fire({
                icon: 'warning',
                title: 'Invalid',
                text: 'Please enter Comments'
            });

            return false;
        }
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to update the data?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, update it!'
        }).then((result) => {
            if (result.isConfirmed) {
                var form = $('#leaveRequestForm');
                var formData = form.serialize();
                $.ajax({
                    url: '/LeaveRequest/Create',
                    method: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Leave Request Submitted',
                                html: 'Your leave request has been submitted successfully. You can track the status of request <b>' + $('#RequestNumber').val() + '</b> on the timeline in the list page.'
                            }).then(() => {
                                window.history.back();
                            });
                            
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Added Failed',
                                text: 'Failed to Add'
                            });
                        }
                    },
                    error: function (xhr) {
                        let errors = xhr.responseJSON;
                        if (errors) {
                            let messages = [];
                            for (let key in errors) {
                                messages.push(errors[key]);
                            }
                           
                            Swal.fire({
                                icon: 'error',
                                title: 'Added Failed',
                                text: 'Failed to Add: ' + messages.join("\n")
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Added Failed',
                                text: 'Failed to Add'
                            });
                        }
                    }
                });
            }
        });

    }

    function getLeaveRequestDetails() {
        let details = [];

        $('#leaveTypeBody tr').each(function (index, row) {
            const $row = $(row);

            const detail = {
                LeaveTypeId: parseInt($row.find(`input[name^="LeaveRequestDetails["][name$="].LeaveTypeId"]`).val()),
                AllocatedDays: parseFloat($row.find(`input[name^="LeaveRequestDetails["][name$="].AllocatedDays"]`).val()) || 0,
                UsedDays: parseFloat($row.find(`input[name^="LeaveRequestDetails["][name$="].UsedDays"]`).val()) || 0,
                BalanceDays: parseFloat($row.find(`input[name^="LeaveRequestDetails["][name$="].BalanceDays"]`).val()) || 0,
                RequiredDays: parseFloat($row.find(`input[name^="LeaveRequestDetails["][name$="].RequiredDays"]`).val()) || 0
            };

            details.push(detail);
        });

        return details;
    }


    function submitWithComment(id, status) {
        Swal.fire({
            title: 'Enter Comments',
            input: 'textarea',
            inputPlaceholder: 'Type your comments here...',
            showCancelButton: true,
            confirmButtonText: 'Submit'
        }).then((result) => {
            if (result.isConfirmed && result.value.trim() !== "") {
                let LeaveRequestDetails = getLeaveRequestDetails();
                const comments = encodeURIComponent(result.value);
                window.location.href = `/LeaveRequest/Approve?id=${id}&Status=${status}&Comments=${comments}&LeaveRequestDetails=${LeaveRequestDetails}`;
            }
        });
    }

    function cancelWithComment(id) {
        Swal.fire({
            title: 'Enter Cancel Comments',
            input: 'textarea',
            inputPlaceholder: 'Why are you cancelling?',
            showCancelButton: true,
            confirmButtonText: 'Submit'
        }).then((result) => {
            if (result.isConfirmed && result.value.trim() !== "") {
                const comments = encodeURIComponent(result.value);
                window.location.href = `/LeaveRequest/Cancel?id=${id}&changedBy=1&Comments=${comments}`;
            }
        });
    }

    flatpickr("#date1", {
        dateFormat: "Y-m-d",     
        altInput: true,
        altFormat: "d-m-Y",    
    });
</script>
