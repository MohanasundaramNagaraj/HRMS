@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
	ViewData["Title"] = "All Clients";
}

<ul class="breadcrumb breadcrumb-style ">
	<li class="breadcrumb-item">
		<h4 class="page-title"> Clients</h4>
	</li>
	<li class="breadcrumb-item bcrumb-1">
		<a href="#">
			<i class="fas fa-add"></i> All Clients
		</a>
	</li>
</ul>
<hr />
<div class="row">
	<div class="col-lg-12 col-md-12 col-sm-12">
		<div class="card">
			<div class="header">
				<h2>
					<strong>All</strong> Clients
				</h2>
				<ul class="header-dropdown m-r--5">
					<li class="dropdown">
						<a href="#" onclick="return false;" class="dropdown-toggle" data-bs-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
							<i class="material-icons">more_vert</i>
						</a>
						<ul class="dropdown-menu float-end">
							<li>
								<a href="#" onclick="return false;">action</a>
							</li>
							
						</ul>
					</li>
				</ul>
			</div>
			<div class="body">
				<div class="table-responsive rounded">
					<div id="datatables_table_0_wrapper" class="dt-container dt-bootstrap5">
						<div class="col-12 ">
							<table class="table table-hover js-basic-example contact_list datatable col-12" id="datatables_table_0" aria-describedby="datatables_table_0_info">
							
								<thead>
									<tr role="row">
										<th class="center dt-type-numeric dt-orderable-asc dt-orderable-desc" data-dt-column="1" rowspan="1" colspan="1" aria-label=" client id : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> client id </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="2" rowspan="1" colspan="1" aria-label=" name : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> Name </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="3" rowspan="1" colspan="1" aria-label=" organization : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> Email </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="4" rowspan="1" colspan="1" aria-label=" mobile : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> Country Code </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="5" rowspan="1" colspan="1" aria-label=" email : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> Phone Number </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="6" rowspan="1" colspan="1" aria-label=" address : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> Address </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="7" rowspan="1" colspan="1" aria-label=" action : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> description </span><span class="dt-column-order"></span></th>
										<th class="center dt-orderable-asc dt-orderable-desc" data-dt-column="7" rowspan="1" colspan="1" aria-label=" action : activate to sort" tabindex="0"><span class="dt-column-title" role="button"> Action </span><span class="dt-column-order"></span></th>
									</tr>
								</thead>
								<tbody id="client-list-container">
									
									<!--Dynamically render data-->
								</tbody>
							</table>
						</div>

					</div>

					<div class="row mt-2">
						<div class="col-12">
							<div class="dt-paging paging_full_numbers d-flex justify-content-center align-items-center">
								<ul class="pagination" id="pagination-container">
									<!-- Pagination buttons will be rendered here dynamically -->
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div> 


<script src="~/js/client/all-clients.js?v=@Configuration["AppSettings:Version"]"></script>
