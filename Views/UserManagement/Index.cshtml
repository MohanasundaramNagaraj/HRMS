@{
    ViewData["Title"] = "User Management";
}

<style>
    input:not([type]), input[type=text]:not(.browser-default), input[type=password]:not(.browser-default), input[type=email]:not(.browser-default), input[type=url]:not(.browser-default),
    input[type=time]:not(.browser-default), input[type=date]:not(.browser-default), input[type=datetime]:not(.browser-default), input[type=datetime-local]:not(.browser-default),
    input[type=tel]:not(.browser-default), input[type=search]:not(.browser-default), textarea.materialize-textarea, input[type=number]:not(.browser-default) {
        border: 1px solid #afafaf;
        padding-left: 5px;
        border-radius: 5px;
        height: 30px;
        font-size: small;
        margin-top: 10px;
    }

    .form-label {
        margin-bottom: .5rem;
        font-weight: bolder;
    }
</style>
<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">User Management </h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>
    </div>
</div>


<div>

    <ul class="nav nav-tabs" id="tabMenu">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#users">Users</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#roles">Roles</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#mapping">User-Role Mapping</a></li>
    </ul>

    <div class="tab-content">
        <!-- USERS TAB -->
        <div id="users" class="tab-pane fade show active">
            <a class="btn btn-tbl-add btn-success mb-2" onclick="openUserModal()" style="float:right;margin-bottom: 0px !important;">
                <i class="material-icons">add</i>
            </a>
            <br />
            <table class="table table-bordered datatable" id="userTable">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Is Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- ROLES TAB -->
        <div id="roles" class="tab-pane fade">

            <a class="btn btn-tbl-add btn-success mb-2" onclick="openRoleModal()" style="float:right;margin-bottom: 0px !important;">
                <i class="material-icons">add</i>
            </a>
            <br />
            <table class="table table-bordered dataTable" id="roleTable">
                <thead><tr><th>Role Name</th><th>Actions</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>

        <!-- MAPPING TAB -->
        <div id="mapping" class="tab-pane fade">
            <a class="btn btn-tbl-add btn-success mb-2" onclick="openUserRoleModal()" style="float:right;margin-bottom: 0px !important;">
               Map User-Role
            </a>
            <br />
            <table class="table table-bordered dataTable" id="userroleMappingTable">
                <thead><tr><th>User Name</th><th>Role Name</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>

    </div>
</div>

<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-full" style="max-width: 800px;">
        <form id="userForm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="userModalTitle">Add User</h5></div>
                <div class="modal-body">
                    <div id="user-form">
                        <input type="hidden" id="ID" />

                        <div class="row">
                            <input type="hidden" id="ID" />
                            <div class="col-md-4 mb-2">
                                <label>User Name <span class="text-danger">*</span></label>
                                <input type="text" id="USERNAME" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label>Email <span class="text-danger">*</span></label>
                                <input type="email" id="EMAIL" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label>Phone Number <span class="text-danger">*</span></label>
                                <input type="text" id="PHONENUMBER" class="form-control" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label id="passwordLbl">Password (for new user) <span class="text-danger">*</span></label>
                                <input type="password" id="PASSWORD" class="form-control" />
                            </div>

                        </div>


                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="saveUser()">SAVE</button>
                    @* <button type="button" class="btn btn-secondary" onclick="clearForm()">CLEAR</button> *@
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="roleForm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="roleModalTitle">Add Role</h5></div>
                <div class="modal-body">
                    <input type="hidden" id="roleId" />
                    <div class="mb-2">
                        <label>Role Name</label>
                        <input type="text" id="roleName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- User Role Modal -->
<div class="modal fade" id="userroleModal" tabindex="-1">
    <div class="modal-dialog">
        <form id="userroleForm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="userroleModalTitle">Map Role</h5></div>
                <div class="modal-body" style="padding:0px;">

                    <div class="mb-2 row col-md-12">
                        <div class="col-md-6">
                            <label>User</label><br />
                            <select id="userSelect" class="form-control mb-2"></select>
                        </div>
                        <div class="col-md-6">
                            <label>Role</label><br />
                            <select id="roleSelect" class="form-control mb-2"></select>
                        </div>
                        <div class="col-md-6">
                            @* <label>Mapped Role</label><br /> *@
                            <ul id="assignedRolesList" class="mt-3"></ul>
                        </div>
                      
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success" onclick="assignRole()">Assign Role</button>
                    <button class="btn btn-danger" onclick="removeRole()">Remove Role</button>
                   
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>


<script>

    const userModal = $('#userModal');
    const roleModal = $('#roleModal');

    // USERS
    function loadUsers() {
        $.get('/UserManagement/GetUsers', function (users) {
            var rows = '';
            $.each(users, function (i, user) {
                rows += `<tr>
                                            <td>${user.UserName}</td>
                                            <td>${user.Email}</td>
                                            <td>${user.PhoneNumber}</td>
                                            <td>${user.IsActive ? 'Yes' : 'No'}</td>
                                            <td>
                                                <button class="btn btn-sm btn-info" onclick='editUser(${JSON.stringify(user)})'>Edit</button>
                                                <button class="btn btn-sm btn-danger" onclick='deleteUser("${user.Id}")'>In Active</button>
                                            </td>
                                         </tr>`;
            });
            $('#userTable tbody').html(rows);
        });
    }

    function loadUserSelect() {
        $.get('/UserManagement/GetUsers', function (data) {
            $('#userSelect').empty();
            data.forEach(u => {
                $('#userSelect').append(`<option value="${u.Id}">${u.UserName}</option>`);
            });
        });
    }

    function openUserModal() {
        $('#ID').val('');
        $('#USERNAME').val('');
        $('#USERNAME').prop('disabled', false);
        $('#EMAIL').val('');
        $('#EMAIL').prop('disabled', false);
        $('#PHONENUMBER').val('');
        $('#userModalTitle').text('Add User');

        $('#PASSWORD').show();
        $('#passwordLbl').show();
        userModal.modal('show');
    }

    function saveUser() {
        const user = {
            Id: $('#ID').val(),
            UserName: $('#USERNAME').val(),
            Email: $('#EMAIL').val(),
            PhoneNumber: $('#PHONENUMBER').val(),
            Password: $('#PASSWORD').val()
        };

        $.ajax({
            url: '/UserManagement/SaveUser',
            type: 'POST',
            // contentType: 'application/json',
            data: user,
            success: function () {
                Swal.fire({
                    title: 'Saved',
                    text: "User saved successfully!",
                    icon: 'success',
                    showCancelButton: false,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Ok'
                }).then((result) => {
                    if (result.isConfirmed) {
                        userModal.modal('hide');
                        loadUsers();
                    }
                });
             
            },
            error: function (xhr) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid',
                    text: 'Error:' + xhr.responseText
                });
            }
        });
    }

    function editUser(user) {

        $('#ID').val(user.Id);
        $('#USERNAME').val(user.UserName);
        $('#USERNAME').prop('disabled', true);
        $('#EMAIL').val(user.Email);
        $('#EMAIL').prop('disabled', true);
        $('#PHONENUMBER').val(user.PhoneNumber);
        $('#PASSWORD').val('');
        $('#PASSWORD').hide();
        $('#passwordLbl').hide();

        $('#userModalTitle').text('Edit User');

        userModal.modal('show');
    }

    function deleteUser(id) {
        if (confirm('Are you sure you want to inactivate this user?')) {
            $.ajax({
                url: '/UserManagement/InactivateUser',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(id),
                success: function () {
                    alert('User inactivated');
                    loadUsers();
                },
                error: function (xhr) {
                    alert('Error: ' + xhr.responseText);
                }
            });
        }
    }

    function clearForm() {
        $('#ID, #USERNAME, #EMAIL, #PHONENUMBER, #PASSWORD').val('');

    }

    // ROLES
    function loadRoles() {
        $.get('/UserManagement/GetRoles', function (roles) {
            let rows = '';
            $('#roleSelect').empty();
            roles.forEach(r => {
                rows += `<tr><td>${r.Name}</td>
                                            <td>
                                                <button class="btn btn-sm btn-info" onclick="editRole('${r.Id}', '${r.Name}')">Edit</button>
                                                <button class="btn btn-sm btn-danger" onclick="deleteRole('${r.Id}')">In Active</button>
                                            </td></tr>`;
                $('#roleSelect').append(`<option>${r.Name}</option>`);
            });
            $('#roleTable tbody').html(rows);


        });
    }

    function openRoleModal() {
        $('#roleId').val('');
        $('#roleName').val('');
        $('#roleModalTitle').text('Add Role');
        roleModal.modal('show');
    }

    function editRole(id, name) {
        $('#roleId').val(id);
        $('#roleName').val(name);
        $('#roleModalTitle').text('Edit Role');
        roleModal.modal('show');
    }

    $('#roleForm').submit(function (e) {
        e.preventDefault();
        const id = $('#roleId').val();
        const roleName = $('#roleName').val();

        if (id) {
            alert("Editing role name not supported via Identity API directly.");
        } else {
            $.post('/UserManagement/CreateRole', { roleName }, () => {
                roleModal.modal('hide');
                alert('Role Saved Successfully');
                loadRoles();
            });
        }
    });

    function deleteRole(id) {
        if (confirm('Delete this role?')) {
            $.ajax({ url: `/UserManagement/DeleteRole?id=${id}`, type: 'DELETE', success: loadRoles });
        }
    }

    // MAPPING
    function openUserRoleModal() {
        $('#userroleModal').modal('show');
    }
    function assignRole() {
        $.post('/UserManagement/AssignRole', {
            userId: $('#userSelect').val(),
            roleName: $('#roleSelect').val()
        }, () => alert("Role assigned"));
    }

    function removeRole() {
        $.post('/UserManagement/RemoveRole', {
            userId: $('#userSelect').val(),
            roleName: $('#roleSelect').val()
        }, () => alert("Role removed"));
    }

    $('#userSelect').change(function () {
        $.get(`/UserManagement/GetUserRoles?userId=${$(this).val()}`, function (roles) {
            $('#assignedRolesList').html(roles.map(r => `<li>${r}</li>`).join(''));
        });
    });

    function loadUserRoles() {
        $.get('/UserManagement/GetUserRolesList', function (userroles) {
            let rows = '';
           
            userroles.forEach(r => {
                rows += `<tr><td>${r.UserName}</td><td>${r.RoleName}</td></tr>`;
            });
            $('#userroleMappingTable tbody').html(rows);


        });
    }

    $(document).ready(function () {
        loadUsers();
        loadRoles();
        loadUserSelect();
        loadUserRoles();
        setTimeout(function () {
            $('.table').DataTable();
            $('#roleTable').css('width', '');
            $('#userroleMappingTable').css('width', '');
        }, 100);
    });
</script>
