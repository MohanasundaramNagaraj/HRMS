@inject SparkHRMS.Utilities.Utility UtilityService
@using SparkHRMS.Data.Entities

@{

    ViewData["Title"] = "Visitor Entry - List";
}

<style>
    input:not([type]), input[type=text]:not(.browser-default), input[type=password]:not(.browser-default), input[type=email]:not(.browser-default), input[type=url]:not(.browser-default),
    input[type=time]:not(.browser-default), input[type=date]:not(.browser-default), input[type=datetime]:not(.browser-default), input[type=datetime-local]:not(.browser-default),
    input[type=tel]:not(.browser-default), input[type=search]:not(.browser-default), textarea.materialize-textarea, input[type=number]:not(.browser-default) {
        border: 1px solid #c7c7c7;
        padding-left: 5px;
        border-radius: 5px;
        height: 37px;
        font-size: small;
    }

    #visitorTable_filter {
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>
<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Visitor Entry</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Maintanance", new { FMode = "ADD" })"
           style="float:right;">
            <i class="material-icons">add</i> <span style="">Add</span>
        </a>
    </div>
</div>
<hr />
@if (true)
{
    <div class="row mb-3">
        <div id="reportrange" style="background: #fff; cursor: pointer; padding: 10px 10px; border: 1px solid #ccc;margin-right:10px;height: 40px;
    border-radius: 5px;">
            <i class="fa fa-calendar"></i>&nbsp;
            <span></span> <i class="fa fa-caret-down"></i>
        </div>

        <input type="hidden" id="startDate" />
        <input type="hidden" id="endDate" />

    </div>
}

<div>
    <table id="visitorTable" class="table table-bordered mt-3 display nowrap" style="width:100%">
        <thead style="top:0px;position:sticky;">
            <tr>
                <th>Visitor Image</th>
                <th>Pass No</th>
                <th>Visitor Name</th>
                <th>Company Name</th>
                <th>Phone Number</th>
                <th>Person to Meet</th>
                <th>Department</th>
                <th>Additional Visitors Count</th>
                <th>In Date & Time </th>
                <th>Out  Date & Time</th>
                <th>Action</th>
            </tr>
        </thead>

    </table>
</div>
<!-- Include these in <head> or before your script -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

<script>
    $(document).ready(function () {
        $('#visitorTable').DataTable({
            processing: true,
            serverSide: true,
            scrollX: true,
            autowidth: true,
            ajax: {
                url: '/Visit/GetVisitors',
                type: 'POST',
                data: function (d) {
                    d.StartDate = $('#startDate').val();
                    d.EndDate = $('#endDate').val();
                }
            },
            columns: [
                {
                    data: 'visitorImage',
                    render: function (data, type, row) {

                        if (data != "data:,") {
                            return `<img src="${data}" alt="Visitor Image" width="50" height="50" style="object-fit:cover; border-radius:5px;" />`;
                        } else {
                            return `<img src="/app/assets/images/user/no-image.png" alt="No Image" width="50" height="50" />`;
                        }
                    }
                },
                { data: 'passNo', className: 'text-left' },
                { data: 'visitorName', className: 'text-left' },
                { data: 'company', className: 'text-left' },
                { data: 'phoneNumber', className: 'text-left' },
                { data: 'personToMeet', className: 'text-left' },
                { data: 'department', className: 'text-left' },
                { data: 'additionalVisitorsCount', className: 'text-right' },
                { data: 'entryDateTime' },
                { data: 'exitDateTime' },
                {
                    data: 'action',

                },

            ],
            initComplete: function () {
                $(".dt-search").append(`<div id="customDatePickerContainer" style="margin-left: 20px; display: inline-block;"></div>`);
                $("#customDatePickerContainer").append($("#reportrange"));

                var start = moment().subtract(0, 'days');
                var end = moment();

                function cb(startDate, endDate) {
                    $('#reportrange span').html(startDate.format('MMMM D, YYYY') + ' - ' + endDate.format('MMMM D, YYYY'));
                    $('#startDate').val(startDate.format('YYYY-MM-DD'));
                    $('#endDate').val(endDate.format('YYYY-MM-DD'));
                    setTimeout(function () {
                        $('#visitorTable').DataTable().ajax.reload();
                    }, 10);

                }

                $('#reportrange').daterangepicker({
                    startDate: start,
                    endDate: end,
                    ranges: {
                        'Today': [moment(), moment()],
                        'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                        'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                        'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                        'This Month': [moment().startOf('month'), moment().endOf('month')],
                        'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                    }
                }, cb);

                cb(start, end);
            },
            ordering: false
        });
    });


    function redirectToMaintanance(fmode, id) {
        const url = `/Visit/Maintanance?FMode=${fmode}&EntryID=${id}`;
        location.href = url;
    }

    function outEntry(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to update the data?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, update it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Visit/OutEntry/' + id,
                    type: 'POST',
                    success: function (res) {
                        Swal.fire({
                            title: 'Updated',
                            text: "Visitor Out entry saved successfully!",
                            icon: 'success',
                            showCancelButton: false,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Ok'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                location.href = "/Visit/Index";
                            }
                        });
                    },
                    error: function (err) {
                        alert('Error saving visitor entry. ' + err.responseText);
                        console.error(err.responseText);
                    }
                });
            }
        });
    }
</script>
