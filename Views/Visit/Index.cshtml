@inject SparkHRMS.Utilities.Utility UtilityService
@using SparkHRMS.Data.Entities
@model List<VisitorEntry>
@{

    ViewData["Title"] = "Visitor Entry - List";
}

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Visitor Entry</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Maintanance", new { FMode = "ADD" })"
           style="float:right;">
            <i class="material-icons">add</i>
        </a>
    </div>
</div>
<hr />
@if (true)
{
    <div class="row mb-3">
        @{
            var yearList = ViewBag.YearList;
        }

        <select name="YearId" id="yearSelector" style="width:20%; margin-right:10px; display:inline-block" class="form-select" required>
            <option value="">All Year</option>

            @foreach (var record in yearList)
            {
                if (ViewBag.SelectedYearId == record.Id)
                {
                    <option value="@record.Id" selected>@record.Year</option>
                }
                else
                {
                    <option value="@record.Id">@record.Year</option>
                }
            }
        </select>
        <select id="monthSelector" style="width:20%;margin-right:10px;display:inline-block" class="form-select" required>
            <option value="">All Month</option>
            @for (int month = 1; month <= 12; month++)
            {
                if (month == ViewBag.SelectedMonth)
                {
                    <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                }
                else
                {
                    <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                }

            }
        </select>
        <button type="button" class="btn btn-secondary btn-sm" style="width:10%;" onclick="getRequestData()">Get Visitor Details</button>
    </div>
}

<br />
<div>
    <table id="visitorTable" class="table table-bordered mt-3 display nowrap" style="width:100%">
        <thead style="top:0px;position:sticky;">
            <tr>
                <th>Pass No</th>
                <th>Visitor Name</th>
                <th>Company</th>
                <th>Phone Number</th>
                <th>Person To Meet</th>
                <th>Department</th>
                <th>Additional Visitors Count</th>
                <th>In Date & Time </th>
                <th>Out  Date & Time</th>
                <th>Action</th>
            </tr>
        </thead>
       @*  <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PassNo</td>
                    <td>@item.VisitorName</td>
                    <td>@item.CompanyName</td>
                    <td>@item.ContactNumber</td>
                    <td>@item.PersonToMeet</td>
                    <td>@item.Department</td>
                    <td>@item.AdditionalVisitorCount</td>
                    <td>@item.InTime.ToString("dd-MM-yyyy HH:mm")</td>
                    <td>@item.OutTime.ToString("dd-MM-yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm btn-primary" onclick="redirectToMaintanance('VIEW', @item.Id)">View</button>
                        <button class="btn btn-sm btn-warning" onclick="redirectToMaintanance('EDIT', @item.Id)">Edit</button>
                        <button class="btn btn-sm btn-danger" onclick="outEntry(@item.Id)">Out</button>
                        <a class="btn btn-sm btn-success" href="/Visit/Print/@item.Id" target="_blank">Print</a>
                    </td>
                </tr>
            }
        </tbody> *@
    </table>
</div>

<script>
    function getRequestData() {
        location.href = "/Visit/Index?YearId=" + $('#yearSelector').val() + '&MonthId=' + $('#monthSelector').val();
    }

    $(document).ready(function () {
        $('#visitorTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: '/Visit/GetVisitors',
                type: 'POST',
                data: function (d) {
                    d.YearId = $('#yearSelector').val();
                    d.MonthId = $('#monthSelector').val();
                }
            },
            columns: [
                { data: 'passNo' },
                { data: 'visitorName' },
                { data: 'company' },
                { data: 'phoneNumber' },
                { data: 'personToMeet' },
                { data: 'department' },
                { data: 'additionalVisitorsCount' },
                { data: 'entryDateTime' },
                { data: 'exitDateTime' },
                { 
                    data: 'action',

                }
            ]
        });
    });

    function redirectToMaintanance(fmode, id) {
        const url = `/Visit/Maintanance?FMode=${fmode}&EntryID=${id}`;
        location.href = url;
    }

    function outEntry(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "Do you want to update the data?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, update it!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Visit/OutEntry/' + id,
                    type: 'POST',
                    success: function (res) {
                        alert('Visitor Out entry saved successfully!');
                        location.href = "/Visit/Index";
                    },
                    error: function (err) {
                        alert('Error saving visitor entry. ' + err.responseText);
                        console.error(err.responseText);
                    }
                });
            }
        });
    }
</script>
