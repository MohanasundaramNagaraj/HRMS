@using Microsoft.AspNetCore.Identity
@using SparkHRMS.Data
@using SparkHRMS.Data.Entities
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Configuration["AppSettings:SiteTitle"] - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SparkHRMS.styles.css" asp-append-version="true" />

    <link rel="icon" href="~/app/assets/images/favicon.ico" type="image/x-icon">
    <!-- Plugins Core Css -->
    <link href="~/app/assets/css/app.min.css" rel="stylesheet">
    <link href="~/app/assets/css/common.min.css" rel="stylesheet">
    <link href="~/app/assets/css/bundles/dataTables.bootstrap5.min.css" rel="stylesheet">
    <!-- Custom Css -->
