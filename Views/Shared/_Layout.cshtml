<!--
    Add below class to body tag for dark theme
    class="dark menu_dark logo-black theme-black ltr side-closed-hover"
-->
<body class="form-control">
    @{
        var user = await UserManager.GetUserAsync(User);

        var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
        var UserImageUrl = "";
        var emp = _context.Employees.Where(x => x.ApplicationUserId == user.Id).FirstOrDefault();

        if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
        {
            UserImageUrl = Url.Content("~/uploads/" + user.UserName + ".jpg");
        }
        else
        {
            int lastSlashIndex = emp.ImageUrl.LastIndexOf('/');
            if (lastSlashIndex >= 0)
            {
                UserImageUrl = Url.Content("~/uploads/" + emp.ImageUrl.Substring(lastSlashIndex + 1));
            }
        }
        // var UserImageUrl = Url.Content("~/images/default-user.png"); // Set the default user image URL
        var UserDesignation = (roles.Contains("Admin") || roles.Contains("SuperAdmin")) ? "Administrator" : roles.Contains("Employee") ? "Employee" : "User";
    }
    <!-- Page Loader -->
    <div class="page-loader-wrapper">
        <div class="loader">
            <div class="m-t-30">
                <img class="loading-img-spin" src="~/app/assets/images/loading.png" alt="admin">
            </div>
            <p>Please wait...</p>
        </div>
    </div>
    <!-- #END# Page Loader -->
    <!-- Overlay For Sidebars -->
    <div class="overlay"></div>
    <!-- #END# Overlay For Sidebars -->
    <!-- Top Bar -->
    <nav class="navbar">
        <div class="container-fluid">
            <div class="navbar-header">
                <a href="#" onClick="return false;" class="navbar-toggle collapsed" data-bs-toggle="collapse"
                   data-bs-target="#navbar-collapse" aria-expanded="false"></a>
                <a href="#" onClick="return false;" class="bars"></a>
                <a class="navbar-brand" href="#">
                    <img src="~/uploads/logo.png" alt="" style="height:100%;" />
                    @*  <img src="~/app/assets/images/logo.png" alt="" /> *@
                    <span class="logo-name">@Configuration["AppSettings:SiteTitle"]</span>
                </a>
            </div>
            <div class="collapse navbar-collapse" id="navbar-collapse">
                <ul class="float-start">
                    <li>
                        <a href="#" onClick="return false;" class="sidemenu-collapse">
                            @* <i data-feather="menu"></i> *@
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="feather feather-menu">
                                <line x1="3" y1="12" x2="21" y2="12"></line>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="3" y1="18" x2="21" y2="18"></line>
                            </svg>
                        </a>
                    </li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
                    {
                        <!-- #START# Notifications-->
                        <li class="dropdown">
                            <a href="#" onClick="return false;" class="dropdown-toggle" data-bs-toggle="dropdown"
                               role="button">
                                <i class="far fa-bell"></i>
                                <span class="notify"></span>
                                <span class="heartbeat"></span>
                            </a>
                            <ul class="dropdown-menu pullDown">
                                <li class="header">NOTIFICATIONS</li>
                                <li class="body">
                                    <ul class="menu">
                                        <li>
                                            <a href="#" onClick="return false;">
                                                <span class="table-img msg-user">
                                                    <img src="~/app/assets/images/user/user1.jpg" alt="">
                                                </span>
                                                <span class="menu-info">
                                                    <span class="menu-title">Sarah Smith</span>
                                                    <span class="menu-desc">
                                                        <i class="material-icons">access_time</i> 14 mins ago
                                                    </span>
                                                    <span class="menu-desc">Please check your email.</span>
                                                </span>
                                            </a>
                                        </li>

                                    </ul>
                                </li>
                                @*  <li class="footer">
                            <a href="#" onClick="return false;">View All Notifications</a>
                            </li> *@
                            </ul>
                        </li>
                        <!-- #END# Notifications-->
                    }
                    else
                    {
                        <li>
                            <button id="checkInBtn" class="btn btn-primary me-2 m-t-10">Check In</button>
                        </li>
                        <li>
                            <button id="checkOutBtn" class="btn btn-danger m-t-10">Check Out</button>
                        </li>
                    }

                    <!-- Full Screen Button -->
                    <li class="fullscreen">
                        <a href="javascript:;" class="fullscreen-btn" onclick="callFullScreen();">
                            <i class="fas fa-expand"></i>
                        </a>
                    </li>
                    <!-- #END# Full Screen Button -->

                    <li class="dropdown user_profile">
                        <div class="dropdown-toggle" data-bs-toggle="dropdown">
                            @* <img src="~/app/assets/images/user.jpg" alt="user"> *@
                            <img src="@UserImageUrl" alt="user" style="height:45px;width:45px;">
                        </div>
                        <ul class="dropdown-menu pullDown">
                            <li class="body">
