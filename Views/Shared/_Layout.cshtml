                                    @*  <li>
                                    <a href="#" onClick="return false;">
                                    <i class="material-icons">person</i>Profile
                                    </a>
                                    </li> *@
                                    <li>
                                        <form asp-area="Identity" asp-page="/Account/ForgotPassword" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">

                                            <a href="javascript:;" onclick="this.closest('form').submit()">
                                                <i class="material-icons">help</i>Reset Password
                                            </a>
                                        </form>
                                    </li>
                                    @*  <li>
                                    <a href="#" onClick="return false;">
                                    <i class="material-icons">feedback</i>Feedback
                                    </a>
                                    </li>
                                    *@
                                    <li>

