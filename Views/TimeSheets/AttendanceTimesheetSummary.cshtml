@using Microsoft.AspNetCore.Identity
@using SparkHRMS.Data.Entities
@using SparkHRMS.Utilities
@using SparkHRMS.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@{
    ViewData["Title"] = "Attendance Time Sheet Report";
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>


<script>
    var timeSheetData = @Html.Raw(Json.Serialize(Model.TimeSheetRecords));
    var attendanceRecords = @Html.Raw(Json.Serialize(Model.AttendanceDetails));

    var activities = @Html.Raw(Json.Serialize(ViewBag.Activities));
</script>
<style>

    input::placeholder {
        color: lightgray !important;
        font-style: italic;
    }

    input:not([type]), input[type=text]:not(.browser-default), input[type=password]:not(.browser-default), input[type=email]:not(.browser-default), input[type=url]:not(.browser-default),
    input[type=time]:not(.browser-default), input[type=date]:not(.browser-default), input[type=datetime]:not(.browser-default), input[type=datetime-local]:not(.browser-default),
    input[type=tel]:not(.browser-default), input[type=search]:not(.browser-default), textarea.materialize-textarea, input[type=number]:not(.browser-default) {
        border: 1px solid #afafaf;
        padding-left: 5px;
        border-radius: 5px;
        height: 30px;
        font-size: small;
        margin-top: 10px;
    }

    .card {
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        padding: 14px;
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

    .card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .card-body {
        padding: 20px;
    }

    .card-title {
        margin: 0 0 10px;
        font-size: 20px;
        font-weight: 600;
    }

    .card-text {
        font-size: 14px;
        color: #555;
        margin-bottom: 15px;
    }

    .card-btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        background: #007bff;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s;
    }

        .card-btn:hover {
            background: #0056b3;
        }
</style>
<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title">Attendance - Timesheet Summary</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#" id="employeeName">
            @Model.EmployeeDetails.Name | @Model.EmployeeDetails.Designation
            @* - <span id="tsRptMonYear"></span> *@
        </a>
    </li>
</ul>

<div class="col-md-12 mb-3">
    <div>
        <div class="">
            @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
            {
                <div style="width:15%;margin-right:15px;display:inline-block">
                    <label>Employee Name</label>
                    <select id="empSelector" class="form-control" onchange="getData()">
                        @{
                            var employeeList = ViewBag.EmployeeList;
                        }

                        @foreach (var record in employeeList)
                        {
                            if (ViewBag.SelectedEmployeeID == record.EmployeeId)
                            {
                                <option value="@record.EmployeeId" selected>@record.EmployeeCode - @record.Name</option>
                            }
                            else
                            {
                                <option value="@record.EmployeeId">@record.EmployeeCode - @record.Name</option>
                            }
                        }
                    </select>
                </div>
            }

            <div style="width:10%;margin-right:15px;display:inline-block" onchange="getData()">
                <label>From Date</label>
                <input type="date" id="filterFromDate" class="form-control" value="@ViewBag.SelectedFromDate.ToString("yyyy-MM-dd")">
            </div>

            <div style="width:10%;margin-right:20px;display:inline-block" onchange="getData()">
                <label>To Date</label>
                <input type="date" id="filterToDate" class="form-control" value="@ViewBag.SelectedToDate.ToString("yyyy-MM-dd")">
            </div>

            <button class="btn btn-warning" style="margin-left:25px;display:inline-block" onclick="exportExcel()">
                <i class="fa fa-file-excel"></i>
                Export to Excel
            </button>
        </div>
    </div>
</div>


