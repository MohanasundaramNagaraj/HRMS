@using Microsoft.AspNetCore.Identity
@using SparkHRMS.Data.Entities
@using SparkHRMS.Utilities
@using SparkHRMS.ViewModels
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@{
    ViewData["Title"] = "Time Sheet";
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    var timeSheetData = @Html.Raw(Json.Serialize(Model.TimeSheetRecords));

    var activities = @Html.Raw(Json.Serialize(ViewBag.Activities));

     var itemTypes = @Html.Raw(Json.Serialize(ViewBag.ItemType));
</script>
<style>

    input::placeholder {
        color: lightgray !important;
        font-style: italic;
    }

    input:not([type]), input[type=text]:not(.browser-default), input[type=password]:not(.browser-default), input[type=email]:not(.browser-default), input[type=url]:not(.browser-default),
    input[type=time]:not(.browser-default), input[type=date]:not(.browser-default), input[type=datetime]:not(.browser-default), input[type=datetime-local]:not(.browser-default),
    input[type=tel]:not(.browser-default), input[type=search]:not(.browser-default), textarea.materialize-textarea, input[type=number]:not(.browser-default) {
        border: 1px solid #afafaf;
        padding-left: 5px;
        border-radius: 5px;
        height: 30px;
        font-size: small;
        margin-top: 10px;
    }
</style>
<ul class="breadcrumb breadcrumb-style ">
    <li class="breadcrumb-item">
        <h4 class="page-title">Time Sheet</h4>
    </li>
    <li class="breadcrumb-item bcrumb-1">
        <a href="#">
            Entry
        </a>
    </li>
</ul>


<div>

    @if (roles.Contains("Admin") || roles.Contains("SuperAdmin") || roles.Contains("User"))
    {
        <div class="col-md-12 mb-3">
            <div>
                <div class="">
                    <select id="yearSelector" style="width:20%; margin-right:10px; display:inline-block">
                        <option value="">Select Year</option>
                        @{
                            var yearList = ViewBag.YearList;
                        }
                        @* @for (int year = 0; year <= yearList; year++) *@
                        @foreach (var year in yearList)
                        {
                            if (year.Id == ViewBag.SelectedYear)
                            {
                                <option value="@year.Id" id="@year.Id" selected>@year.Year</option>
                            }
                            else
                            {
                                <option value="@year.Id" id="@year.Id">@year.Year</option>
                            }
                        }
                    </select>
                    <select id="monthSelector" style="width:20%;margin-right:10px;display:inline-block">
                        <option value="">Select Month</option>
                        @for (int month = 1; month <= 12; month++)
                        {
                            if (month == ViewBag.SelectedMonth)
                            {
                                <option value="@month" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                            else
                            {
                                <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month)</option>
                            }
                        }
                    </select>
                    <select style="width:35%;margin-right:10px;display:inline-block" id="empSelector">
                        @{
                            var employeeList = ViewBag.EmployeeList;
                        }

                        @foreach (var record in employeeList)
                        {
                            if (ViewBag.SelectedEmployeeID == record.EmployeeId)
                            {
                                <option value="@record.EmployeeId" selected>@record.EmployeeCode - @record.Name</option>
                            }
                            else
                            {
                                <option value="@record.EmployeeId">@record.EmployeeCode - @record.Name</option>
                            }
                        }
                    </select>
                    <button onclick="getData()" class="btn btn-info">
                        Filter
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="col-lg-12 col-md-12">

        <div class="tab-content">
            <div role="tabpanel" class="tab-pane active" id="project" aria-expanded="true">
                <div class="row clearfix">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        <div class="card">
                            <div class="chat">
                                <div class="chat-header clearfix">
                                    @{
                                        var UserImageUrl = "";
                                        int lastSlashIndex = @Model.EmployeeDetails.ImageUrl.LastIndexOf('/');
                                        if (lastSlashIndex >= 0)
                                        {
                                            UserImageUrl = Url.Content("~/uploads/" + Model.EmployeeDetails.ImageUrl.Substring(lastSlashIndex + 1));
                                        }
                                    }
                                    <img src="@UserImageUrl" alt="avatar" style="    height: 45px;">
                                    <div class="row">
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with" id="employeeName">@Model.EmployeeDetails.Name</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.Designation</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">Employee ID</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.EmpCode</div>
                                                <div style="display:none;">@Model.EmployeeDetails.EmployeeId</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">Joining Date</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.DateOfJoining?.ToString("dd MMM yyyy")</div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-sm-6">
                                            <div class="chat-about">
                                                <div class="chat-with">Email</div>
                                                <div class="chat-num-messages">@Model.EmployeeDetails.Email</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div style="float:right;margin-bottom:10px;    justify-content: flex-end;gap: 10px; display: flex; cursor:marker;">

                        <button class="btn btn-success" onclick="update()"><i class="fa fa-save"></i> Save</button>
                        <button class="btn btn-warning"
                                onclick="exportToExcel('@Model.EmployeeDetails.Name','@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(ViewBag.SelectedMonth)','@ViewBag.SelectedYear')">
                            <i class="fa fa-file-excel"></i>
                            Export to Excel
                        </button>
                        <button class="btn btn-danger" onclick="exportToPDF('@Model.EmployeeDetails.Name','@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(ViewBag.SelectedMonth)','@ViewBag.SelectedYear')"> <i class="fa fa-file"></i> Export to PDF</button>

                        @*   <button class="btn btn-primary" onclick="generateFullReport()">
                            Report
                        </button> *@

                        @* <button class="btn btn-primary" onclick="printTable()"> <i class="fa fa-print"></i> Print</button> *@
                    </div>
                    <br />
                    <div>
                        <table id="timesheetTable" class="table table-bordered">
                            <thead>
                                <tr>

                                    <th>
                                        Date
                                    <th>
                                        Day
                                    </th>
                                    <th>
                                        Item Type
                                    </th>
                                    <th>
                                        Item Id
                                    </th>
                                    <th>
                                        Activity
                                    <th>
                                        Description
                                    <th>
                                        Hours Worked
                                    </th>
                                    <th>
                                        Actions
                                    </th>
                                </tr>
                                <tr>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Date">
                                    </th>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Day">
                                    </th>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Item Type">
                                    </th>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Item Id">
                                    </th>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Activity">
                                    </th>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Description">
                                    </th>
                                    <th style="background:white;">
                                        <input type="text" class="column-filter form-control" placeholder="Search Hours">
                                    </th>

                                    <th style="background:white;"></th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>

                    </div>

                </div>
            </div>


        </div>
    </div>
</div>

<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <form id="userForm">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="userModalTitle">Timesheet Report - <span id="employeeNameText"></span> - <span id="tsRptMonYear"></span></h5></div>
                <div class="modal-body">

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label><b>Filter By:</b></label>

                        </div>
                        <div class="col-md-3">
                            <label>Date</label>
                            <input type="date" id="filterFromDate" class="form-control">
                        </div>

                        @*    <div class="col-md-3">
                            <label>To Date</label>
                            <input type="date" id="filterToDate" class="form-control">
                        </div> *@

                        <div class="col-md-3">
                            <label>Task</label>
                            <input type="text" id="filterTask" class="form-control" placeholder="Task Id">
                        </div>

                        <div class="col-md-3">
                            <label>Activity</label>
                            <input type="text" id="filterActivity" class="form-control" placeholder="Activity">
                        </div>

                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="d-flex gap-4">
                                <label class="fw-bold">Group By</label>
                                <label>
                                    <input type="checkbox" class="group-by" value="date" checked> Date
                                </label>
                                <label>
                                    <input type="checkbox" class="group-by" value="task" checked> Task
                                </label>
                                <label>
                                    <input type="checkbox" class="group-by" value="activity" checked> Activity
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row col-md-12">
                        <div class="col-md-6" style="    max-height: 500px; overflow-y: scroll;">
                            <div class="table-responsive mb-4">
                                <table class="table table-bordered" id="reportTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Task</th>
                                            <th>Activity</th>
                                            <th>Total Hours</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class=" col-md-6" style="max-height: 500px; overflow-y: scroll;">
                            @* <div id="barChart" ></div> *@
                            @*  <div id="lineChart" style="height:400px;"></div> *@
                            <div id="pieChart" style="height:400px;"></div>
                            @*  <div id="stackChart" style="height:400px;"></div> *@

                        </div>
                    </div>
                </div>
                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>



@section Scripts {
  
    <script src="https://cdn.jsdelivr.net/npm/echarts/dist/echarts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/exceljs/dist/exceljs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/file-saver/dist/FileSaver.min.js"></script>

    <script src="~/js/timesheet.js"></script>

}

