@model IEnumerable<SparkHRMS.Data.Setting.LeaveType>

@{
    ViewData["Title"] = "Leave Types";
}

<div class="row mr-0">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <ul class="breadcrumb breadcrumb-style" style="display:inline">
            <li class="breadcrumb-item">
                <h4 class="page-title">Leave Types</h4>
            </li>
            <li class="breadcrumb-item bcrumb-1">
                <a href="#">
                    <i class="fas fa-add"></i> List
                </a>
            </li>
        </ul>

        <a class="btn btn-tbl-add btn-success" href="@Url.Action("Create")" style="float:right;">
            <i class="material-icons">add</i>
        </a>
    </div>
</div>


<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Description</th>
            <th>Max Days/Year</th>
            <th>Applicable After Days</th>
            <th>Max Consecutive/Month</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var leave in Model)
        {
            <tr>
                <td >@leave.Code</td>
                <td>@leave.Name</td>
                <td>@leave.Description</td>
                <td>@leave.MaxAllowedDaysPerYear</td>
                <td>@leave.ApplicableAfterWorkingDays</td>
                <td>@leave.MaxConsecutiveLeaveAllowedDaysPerMonth</td>
                <td>@(leave.IsActive ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-warning" href="@Url.Action("Edit", new { id = leave.LeaveTypeId })">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('.table').DataTable();
    });
</script>