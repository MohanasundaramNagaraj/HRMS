@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";

}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <hr />
    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div class="col-md-12 row">
            <div class="col-md-6 col-md-offset-2">
               
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="User Name" />
                    <label asp-for="Input.Email">UserName</label>
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Is Active -->
                <div class="form-check mb-3">
                    <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="Input.IsActive" class="form-check-label">Is Active</label>
                </div>

            </div>

            <div class="col-md-6 col-md-offset-2">
                <!-- Phone Number -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.PhoneNumber" type="tel" class="form-control" placeholder="Phone Number" />
                    <label asp-for="Input.PhoneNumber">Phone Number</label>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
                
                <!-- Image Upload -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.ImageUrl" type="file" class="form-control" placeholder="Image URL" />
                    <label asp-for="Input.ImageUrl">Upload Image</label>
                    <span asp-validation-for="Input.ImageUrl" class="text-danger"></span>
                </div>

                <!-- Date of Joining -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.DateOfJoining" type="date" class="form-control" />
                    <label asp-for="Input.DateOfJoining">Date of Joining</label>
                    <span asp-validation-for="Input.DateOfJoining" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Address" class="form-control" placeholder="Enter Address" />
                    <label asp-for="Input.Address">Address</label>
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>
                <!-- Role -->
                <div class="form-floating mb-3">
                    <select asp-for="Input.RoleId" class="form-control">
                        <option value="">Select Role</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Value">@role.Text</option>
                        }
                    </select>
                    <label asp-for="Input.RoleId">Role</label>
                    <span asp-validation-for="Input.RoleId" class="text-danger"></span>
                </div>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
