@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<html>
    <head>
    <title>Login</title>

    <!-- Plugins Core Css -->
    <link href="~/app/assets/css/app.min.css" rel="stylesheet">

    <!-- Custom Css -->
    <link href="~/app/assets/css/style.css" rel="stylesheet" />

    <!-- Theme style. You can choose a theme from css/themes instead of get all themes -->
    <link href="~/app/assets/css/styles/all-themes.css" rel="stylesheet" />

    <!-- Favicon-->
    <link rel="icon" href="~/app/assets/images/favicon.ico" type="image/x-icon">
    <!-- Plugins Core Css -->
    <link href="~/app/assets/css/common.min.css" rel="stylesheet">
    <link href="~/app/assets/css/pages/extra_pages.css" rel="stylesheet" />
    <link href="~/css/common.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body>
    <div class="limiter">
        <div class="container-login100">
            <div class="wrap-login100">
                <form class="login100-form validate-form" id="account" method="post">
                    <span class="login100-form-title p-b-45">
                        Register
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </span>
                    
                   @*  <div class="wrap-input100 validate-input" data-validate="Username is required">
						
                        <input asp-for="Input.UserName" class="input100" autocomplete="username" type="text" name="username" aria-required="true" />
						<span class="focus-input100"></span>
						<span class="label-input100">Username</span>
                        <span asp-validation-for="Input.UserName" class="text-danger"></span>
					</div> *@
					<div class="wrap-input100 validate-input" data-validate="Enter valid email address">
						 <input asp-for="Input.Email" class="input100" autocomplete="username" aria-required="true"  />
                        <span class="focus-input100"></span>
						<span class="label-input100">Email</span>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
					</div>
                    <div class="wrap-input100 validate-input" data-validate="Password is required">
                        <input asp-for="Input.Password" class="input100" autocomplete="new-password" aria-required="true"  />
                        <span class="focus-input100"></span>
						<span class="label-input100">Password</span>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
					</div>
					<div class="wrap-input100 validate-input" data-validate="Password is required">
						 <input asp-for="Input.ConfirmPassword" class="input100" autocomplete="new-password" aria-required="true" />
                        <span class="focus-input100"></span>
						<span class="label-input100">Confirm Password</span>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
					</div>
					<div class="flex-sb-m w-full p-t-15 p-b-20">
						<div>
							<a href="./Login" class="txt1">
								Already Registered?
							</a>
						</div>
					</div>

                    <div class="container-login100-form-btn">
                        <button class="login100-form-btn" id="login-submit" type="submit">
                            REGISTER
                        </button>
                    </div>
                   
                </form>
                <div class="login100-more" style="background-image: url('/app/assets/images/pages/bg-01.png');">
                </div>
            </div>
        </div>
    </div

    <!-- Plugins Js -->
<script src="~/app/assets/js/common.min.js"></script>
<!-- Extra page Js -->
<script src="~/app/assets/js/pages/examples/pages.js"></script>
</body>
</html>





