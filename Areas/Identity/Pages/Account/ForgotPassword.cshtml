@page
@model ForgotPasswordModel
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = null;
}

<html>
<head>
    <title>Forget Password</title>

    <!-- Plugins Core Css -->
    <link href="~/app/assets/css/app.min.css" rel="stylesheet">

    <!-- Custom Css -->
    <link href="~/app/assets/css/style.css" rel="stylesheet" />

    <!-- Theme style. You can choose a theme from css/themes instead of get all themes -->
    <link href="~/app/assets/css/styles/all-themes.css" rel="stylesheet" />

    <!-- Favicon-->
    <link rel="icon" href="~/app/assets/images/favicon.ico" type="image/x-icon">
    <!-- Plugins Core Css -->
    <link href="~/app/assets/css/common.min.css" rel="stylesheet">
    <link href="~/app/assets/css/pages/extra_pages.css" rel="stylesheet" />
    <link href="~/css/common.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body>
    <div class="limiter">
        <div class="container-login100">
            <div class="wrap-login100">
                <form class="login100-form validate-form" method="post">
                    <span class="login100-form-title p-b-20" method="post">
                       @Configuration["AppSettings:SiteTitle"]
                    </span> 
                    <span class="login100-form-title p-b-45" method="post">
                        Reset Password
                    </span>
                    <span class="error-subheader2 p-t-20 p-b-15">
                        Enter your registered email address.
                    </span>
                   
                        <div class="wrap-input100 validate-input" data-validate="Valid email is required: ex@abc.xyz">
                            @* <input class="input100" type="text" name="email"> *@
                            <input asp-for="Input.Email" class="input100" autocomplete="username" type="text" name="email" aria-required="true"/>
                            <span class="focus-input100"></span>
                            <span class="label-input100">Email</span>
                        </div>
                        <div class="container-login100-form-btn p-t-30">
                            <button class="login100-form-btn" type="submit">
                                Reset My Password
                            </button>
                        </div>
                    
                    <div class="w-full p-t-25 text-center">
                        <div>
                            <a href="./Login" class="txt1">
                                Login?
                            </a>
                        </div>
                    </div>
                </form>
                <div class="login100-more" style="background-image: url('/app/assets/images/pages/bg-01.png');">
                </div>
            </div>
        </div>
        <script src="~/app/assets/js/common.min.js"></script>
        <!-- Extra page Js -->
        <script src="~/app/assets/js/pages/examples/pages.js"></script>
</body>
</html>
